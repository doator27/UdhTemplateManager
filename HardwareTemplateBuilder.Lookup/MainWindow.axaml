<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HardwareTemplateBuilder.Lookup.MainWindow"
        Title="Template Lookup"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="8">

        <TextBlock DockPanel.Dock="Top"
                   Text="Template Lookup"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <!-- Search filter row -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#808080" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer"  Margin="0,0,0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Description"   Margin="4,0,0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Model Number"  Margin="4,0,0,2"/>

                <ComboBox Grid.Row="1" Grid.Column="0" Name="MfrCombo"
                          HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="DescCombo"
                          HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                <TextBox  Grid.Row="1" Grid.Column="2" Name="ModelBox"
                          Watermark="Model #"/>
            </Grid>
        </Border>

        <!-- Progress + status (docked bottom) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar Name="GenerateProgress"
                         IsIndeterminate="True" IsVisible="False"
                         Height="14" Margin="0,0,0,4"/>
            <TextBlock Name="StatusLabel" Foreground="#800000" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Results list (left) + action panel (right) -->
        <Grid ColumnDefinitions="*,220">

            <!-- Hardware item listbox -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Matching hardware items (sorted by frequency):"
                           Margin="0,0,0,4"/>
                <ListBox Name="ResultsList"/>
            </DockPanel>

            <!-- Action panel -->
            <Border Grid.Column="1"
                    BorderBrush="#808080" BorderThickness="1"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="Selected Item" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Name="SelectedMfrLabel"   TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedDescLabel"  TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedModelLabel" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedFreqLabel"  Foreground="#606060" Margin="0,0,0,12"/>

                    <Button Name="OpenButton"
                            Content="Open Templates"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
