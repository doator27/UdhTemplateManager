<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HardwareTemplateBuilder.Lookup.MainWindow"
        Title="Template Lookup"
        Width="900"
        Height="620"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="8">

        <TextBlock DockPanel.Dock="Top"
                   Text="Template Lookup"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <!-- Progress + status (docked bottom) -->
        <ProgressBar DockPanel.Dock="Bottom" Name="GenerateProgress"
                     IsIndeterminate="True" IsVisible="False"
                     Height="14" Margin="0,8,0,4"/>
        <TextBlock DockPanel.Dock="Bottom" Name="StatusLabel" Foreground="#800000" TextWrapping="Wrap"/>

        <!-- Manufacturer / Description / Model# (cascading, multi-select) + Selected Item panel -->
        <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,220">

            <DockPanel Grid.Column="0" MinWidth="120" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Manufacturer" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="MfrList" SelectionMode="Multiple"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" Background="#808080" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>

            <DockPanel Grid.Column="2" MinWidth="120" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Description" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="DescList" SelectionMode="Multiple"/>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="6" Background="#808080" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>

            <DockPanel Grid.Column="4" MinWidth="120" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Model #" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="ModelList"/>
            </DockPanel>

            <GridSplitter Grid.Column="5" Width="6" Background="#808080" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>

            <!-- Selected item + action panel -->
            <Border Grid.Column="6"
                    Margin="8,0,0,0"
                    BorderBrush="#808080" BorderThickness="1"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="Selected Item" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Name="SelectedMfrLabel"   TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedDescLabel"  TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedModelLabel" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedFreqLabel"  Foreground="#606060" Margin="0,0,0,12"/>

                    <Button Name="OpenButton"
                            Content="Open Templates"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
