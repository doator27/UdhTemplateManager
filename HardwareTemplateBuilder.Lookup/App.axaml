             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.Lookup.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://HardwareTemplateBuilder.Lookup/Styles/Win98Theme.axaml" />
    </Application.Styles>
</Application>
