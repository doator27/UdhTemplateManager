<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WPF frontend for Hardware Template Builder with a Windows 95 look.
    Functionally mirrors HardwareTemplateBuilder.App (the Avalonia frontend) and shares
    HardwareTemplateBuilder.Core with it. Windows-only at runtime; EnableWindowsTargeting lets
    the solution still build on Linux (CI and dev machines).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target: needed for the built-in text recognition used on scanned PDFs (Shared/WindowsPdfOcrEngine.cs). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <StartupObject>HardwareTemplateBuilder.Wpf.Program</StartupObject>
    <!-- App.xaml is compiled as a plain Page so Program.Main can own startup (single-instance
         mutex, AppUserModelID) before the WPF Application starts. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Hardware Template Builder 95</Product>
    <Description>Hardware Template Builder (WPF, Windows 95 edition)</Description>
    <AssemblyName>HardwareTemplateBuilder.Wpf</AssemblyName>
    <RootNamespace>HardwareTemplateBuilder.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="4.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Draw text selection inside the text (not as a translucent overlay) so TextBox.SelectionTextBrush
         works: selected text is white on the Win95 navy highlight instead of black on navy. -->
    <RuntimeHostConfigurationOption Include="System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HardwareTemplateBuilder.Core\HardwareTemplateBuilder.Core.csproj" />
    <Compile Include="..\Shared\WindowsPdfOcrEngine.cs" Link="Helpers\WindowsPdfOcrEngine.cs" />
  </ItemGroup>
</Project>
