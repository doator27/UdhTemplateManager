<Window x:Class="HardwareTemplateBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Template Builder"
        Icon="/HardwareTemplateBuilder.Wpf;component/Assets/AppIcon.ico"
        Width="1180" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Win95Window}">

    <!--
        Same shell as the Avalonia app: a persistent menu bar (File, Jobs, Template Lookup,
        Maintenance, Admin), the active view in the middle, and a status bar along the bottom.
        Menu items with a Tag navigate to that route; the rest run a command.
    -->
    <DockPanel>
        <!-- Top menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="About" Click="About_Click"/>
                <Separator/>
                <MenuItem Header="Change User Profile" Click="ChangeUser_Click"/>
                <MenuItem Header="Database Location..." Click="DatabaseLocation_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Jobs" Tag="Jobs" Click="Nav_Click"/>
            <MenuItem Header="Template Lookup" Tag="TemplateLookup" Click="Nav_Click"/>
            <MenuItem Header="Maintenance">
                <MenuItem Header="Batch Generate..." Tag="BatchGenerate" Click="Nav_Click"/>
                <MenuItem Header="Transfer Job..." Tag="TransferJob" Click="Nav_Click"/>
                <MenuItem Header="Refresh Templates" Tag="RefreshTemplates" Click="Nav_Click"/>
                <MenuItem Header="Templates to Fix..." Tag="TemplateFixList" Click="Nav_Click"/>
                <MenuItem Header="Product Catalogs..." Tag="ProductCatalogs" Click="Nav_Click"/>
                <MenuItem Header="Template Description Audit..." Tag="TemplateAudit" Click="Nav_Click"/>
                <MenuItem Header="Deduplicate Hardware..." Tag="DeduplicateHardware" Click="Nav_Click"/>
                <MenuItem Header="Relink Templates..." Click="RelinkTemplates_Click"/>
                <Separator/>
                <MenuItem Header="Dump Database..." Click="DumpDatabase_Click"/>
                <MenuItem Header="Export SQL Server Script..." Click="ExportSqlServerScript_Click"/>
                <Separator/>
                <MenuItem Header="Import Legacy Database..." Click="ImportLegacyDatabase_Click"/>
                <MenuItem Header="Import Jobs Wizard..." Tag="JobImportWizard" Click="Nav_Click"/>
            </MenuItem>
            <MenuItem Header="Admin">
                <MenuItem Header="Hardware Items" Tag="HardwareItems" Click="Nav_Click"/>
                <MenuItem Header="Templates" Tag="Templates" Click="Nav_Click"/>
                <Separator/>
                <MenuItem Header="App Settings" Tag="AppSettings" Click="Nav_Click"/>
                <Separator/>
                <MenuItem Header="Customers" Tag="Customers" Click="Nav_Click"/>
                <MenuItem Header="Manufacturers" Tag="Manufacturers" Click="Nav_Click"/>
                <MenuItem Header="Descriptions" Tag="Descriptions" Click="Nav_Click"/>
                <MenuItem Header="Project Managers" Tag="ProjectManagers" Click="Nav_Click"/>
                <MenuItem Header="User Profiles" Tag="UserProfiles" Click="Nav_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status bar: thin sunken fields -->
        <Grid DockPanel.Dock="Bottom" Margin="2,0,2,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{StaticResource StatusField}" Margin="0,0,2,0">
                <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"/>
            </ContentControl>
            <ContentControl Grid.Column="1" Style="{StaticResource StatusField}" MinWidth="160" Margin="0,0,2,0">
                <TextBlock x:Name="UserStatusText" Text="No user"/>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{StaticResource StatusField}" MinWidth="70">
                <TextBlock x:Name="ClockText" HorizontalAlignment="Right"/>
            </ContentControl>
        </Grid>

        <!-- Etched line under the menu bar, then the content area where views are swapped in -->
        <Separator DockPanel.Dock="Top" Margin="0,0,0,2"/>
        <ContentControl x:Name="ContentArea" Margin="2" Focusable="False"/>
    </DockPanel>
</Window>
