<Window x:Class="HardwareTemplateBuilder.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Template Builder"
        Icon="/HardwareTemplateBuilder.Wpf;component/Assets/AppIcon.ico"
        Width="1180" Height="800" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource Win95Window}">

    <!--
        Same shell as SpecialJobLookup: a Start-menu style sidebar on the left (navy gradient
        banner + grouped items), the active view in the middle, and a status bar of thin sunken
        fields along the bottom. The sidebar replaces the Avalonia app's File/Jobs/Maintenance/
        Admin menu bar; every menu command is here under the same group names.
    -->
    <DockPanel>
        <!-- Status bar -->
        <Grid DockPanel.Dock="Bottom" Margin="2,0,2,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{StaticResource StatusField}" Margin="0,0,2,0">
                <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"/>
            </ContentControl>
            <ContentControl Grid.Column="1" Style="{StaticResource StatusField}" MinWidth="160" Margin="0,0,2,0">
                <TextBlock x:Name="UserStatusText" Text="No user"/>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{StaticResource StatusField}" MinWidth="70">
                <TextBlock x:Name="ClockText" HorizontalAlignment="Right"/>
            </ContentControl>
        </Grid>

        <!-- Sidebar, styled like the Start menu -->
        <ContentControl DockPanel.Dock="Left" Style="{StaticResource Raised}" Width="220" Margin="2,2,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1084D0" Offset="0"/>
                            <GradientStop Color="#000080" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                               Foreground="White" FontSize="14">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                        <Run Text="Template" FontWeight="Bold"/><Run Text="Builder 95"/>
                    </TextBlock>
                </Border>

                <DockPanel Grid.Column="1">
                    <!-- File menu items live at the bottom, where Start had Settings / Shut Down -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,2">
                        <Separator Margin="4,4,4,2"/>
                        <Button Style="{StaticResource NavActionButton}" Content="Change _User Profile..." Click="ChangeUser_Click"/>
                        <Button Style="{StaticResource NavActionButton}" Content="_Database Location..." Click="DatabaseLocation_Click"/>
                        <Button Style="{StaticResource NavActionButton}" Content="_About..." Click="About_Click"/>
                        <Separator Margin="4,2"/>
                        <Button Style="{StaticResource NavActionButton}" Content="E_xit" Click="Exit_Click"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel" Margin="0,2,0,2">
                            <RadioButton Style="{StaticResource NavButton}" Tag="Jobs" Content="_Jobs" FontWeight="Bold"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="TemplateLookup" Content="_Template Lookup"/>

                            <Separator Margin="4,4,4,0"/>
                            <TextBlock Text="Maintenance" Style="{StaticResource SidebarHeader}"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="BatchGenerate" Content="_Batch Generate"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="TransferJob" Content="Transfer Job"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="RefreshTemplates" Content="_Refresh Templates"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="DeduplicateHardware" Content="Deduplicate Hardware"/>
                            <Button Style="{StaticResource NavActionButton}" Content="Relink Templates..." Click="RelinkTemplates_Click"/>
                            <Button Style="{StaticResource NavActionButton}" Content="Dump Database..." Click="DumpDatabase_Click"/>
                            <Button Style="{StaticResource NavActionButton}" Content="Export SQL Server Script..." Click="ExportSqlServerScript_Click"/>
                            <Button Style="{StaticResource NavActionButton}" Content="Import Legacy Database..." Click="ImportLegacyDatabase_Click"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="JobImportWizard" Content="Import Jobs Wizard"/>

                            <Separator Margin="4,4,4,0"/>
                            <TextBlock Text="Admin" Style="{StaticResource SidebarHeader}"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="HardwareItems" Content="_Hardware Items"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="Templates" Content="Templates"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="AppSettings" Content="App _Settings"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="Customers" Content="_Customers"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="Manufacturers" Content="_Manufacturers"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="Descriptions" Content="Descriptions"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="ProjectManagers" Content="_Project Managers"/>
                            <RadioButton Style="{StaticResource NavButton}" Tag="UserProfiles" Content="User Profiles"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </ContentControl>

        <!-- Main content area: views are swapped in here -->
        <ContentControl x:Name="ContentArea" Margin="2" Focusable="False"/>
    </DockPanel>
</Window>
