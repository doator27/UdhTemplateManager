<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.JobDetailView">
    <DockPanel Margin="8">
        <!-- Top: navigation + action buttons + job title -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" x:Name="BackButton"         Content="← Back to Jobs"  Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Left" x:Name="MarkCompleteButton" Content="✓ Mark Complete"  Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Left" x:Name="ReactivateButton"   Content="↺ Reactivate"    Visibility="Collapsed" Margin="0,0,6,0"/>
            <TextBlock x:Name="JobStatusLabel" DockPanel.Dock="Left"  VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource MutedTextBrush}" FontStyle="Italic"/>
            <Border  Style="{StaticResource CaptionBar}"><TextBlock x:Name="JobTitleLabel"  Style="{StaticResource CaptionText}"/></Border>
        </DockPanel>

        <!-- Release selector -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Release:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Left" x:Name="NewReleaseButton" Content="+ New Release…" Margin="6,0,0,0"/>
            <ComboBox x:Name="ReleaseCombo" DockPanel.Dock="Left" Width="260" Margin="0,0,0,0"/>
        </DockPanel>

        <ScrollViewer>
            <StackPanel>

                <!-- Job Attachments sub-panel -->
                <GroupBox Header="Job Attachments" Margin="0,0,0,8">
                    <StackPanel>
                        
                        <StackPanel x:Name="AttachmentsBody">
                            <ListBox x:Name="AttachmentList" Height="110" Margin="0,0,0,8"/>
                            <Grid ui:GridEx.Columns="Auto,*" Margin="0,0,0,6">
                                <TextBlock Grid.Column="0" Text="Note (optional):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox   Grid.Column="1" x:Name="AttachmentNoteBox" ui:Watermark.Text="Describe this file…"/>
                            </Grid>
                            <ui:Stack Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                <Button x:Name="AddFileButton"          Content="+ Add File…"/>
                                <Button x:Name="OpenAttachmentButton"   Content="Open"/>
                                <Button x:Name="RemoveAttachmentButton" Content="Remove"/>
                            </ui:Stack>
                            <TextBlock x:Name="AttachmentStatusLabel" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Linked Hardware Items sub-panel -->
                <GroupBox Header="Linked Hardware Items" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <ui:Stack Orientation="Horizontal" Spacing="6">
                                <Button x:Name="BulkAddButton"      Content="Add Hardware"/>
                                <Button x:Name="ImportHardwareButton" Content="Import Hardware"/>
                            </ui:Stack>
                        </StackPanel>

                        <StackPanel x:Name="LinkedHardwareBody">

                            <ListBox x:Name="LinkedHardwareList" Height="180" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Button x:Name="RemoveHardwareButton" Content="Remove from Job" Margin="0,0,6,0"/>
                                <Button x:Name="RemoveAllHardwareButton" Content="Remove All Hardware"/>
                            </StackPanel>
                            <TextBlock x:Name="LinkStatusLabel" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- PDF Package Generation sub-panel -->
                <GroupBox Header="PDF Package Generation">
                    <StackPanel>
                        

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="GeneratePackageButton"    Content="Generate Package"    Margin="0,0,8,0"/>
                            <Button x:Name="OpenCurrentPackageButton" Content="Open Current Package" Margin="0,0,8,0"/>
                            <Button x:Name="BrowseOldVersionsButton"  Content="Browse Old Versions" Margin="0,0,8,0"/>
                            <Button x:Name="OpenJobFolderButton"      Content="Open Job Folder" Margin="0,0,8,0"/>
                            <Button x:Name="MissingTemplatesButton"   Content="Missing Templates"/>
                        </StackPanel>
                        <ui:Stack Orientation="Horizontal" Margin="0,0,0,8" Spacing="6">
                            <ComboBox x:Name="ManufacturerFilterComboBox" Width="220" ui:Watermark.Text="Select manufacturer…"/>
                            <Button x:Name="FilterDescriptionsButton" Content="Filter Descriptions…"/>
                            <Button x:Name="GenerateForManufacturerButton" Content="Generate Cover Sheet for Manufacturer"/>
                        </ui:Stack>
                        <ProgressBar x:Name="PackageProgress"
                                     IsIndeterminate="True" Visibility="Collapsed"
                                     Height="14" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PackageStatusLabel" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
