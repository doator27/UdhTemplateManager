<ui:Win95Window x:Class="HardwareTemplateBuilder.Wpf.Views.DatabaseSetupDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
                Title="Database Setup"
                Width="530" Height="380"
                WindowStartupLocation="CenterScreen"
                ResizeMode="NoResize">
    <DockPanel Margin="10">

        <!-- Error banner: shown only when the previously configured connection is unreachable -->
        <ContentControl x:Name="ErrorPanel" DockPanel.Dock="Top" Style="{StaticResource Sunken}"
                        Background="{StaticResource TooltipBrush}" Padding="8,6" Margin="0,0,0,8"
                        Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Database Unreachable" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
                <TextBlock x:Name="UnreachablePathLabel" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
            </StackPanel>
        </ContentControl>

        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6">
            <TextBlock x:Name="HeaderLabel" Text="Connect to the Shared Database" Style="{StaticResource CaptionText}"/>
        </Border>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Enter the MySQL connection string used by every workstation to reach the shared, centralized database."/>

        <GroupBox Header="MySQL connection string" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                           Text="Example: Server=localhost;Port=3306;Database=hardware_templates;Uid=root;Pwd=secret;"/>
                <TextBox x:Name="ConnectionStringBox" AcceptsReturn="False" Margin="0,0,0,8"
                         ui:Watermark.Text="Server=...;Port=3306;Database=...;Uid=...;Pwd=...;"/>
                <Button x:Name="ConnectButton" Content="Connect" HorizontalAlignment="Left" IsDefault="True"/>
                <TextBlock x:Name="ConnectStatusLabel" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </DockPanel>
</ui:Win95Window>
