<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.ManufacturersView">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6"><TextBlock Text="Manufacturers" Style="{StaticResource CaptionText}"/></Border>
        <Grid ui:GridEx.Columns="250,Auto,*">
            <DockPanel Grid.Column="0" MinWidth="150" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Filter:" Margin="0,0,0,2" />
                <TextBox DockPanel.Dock="Top" x:Name="FilterBox" ui:Watermark.Text="Search..." Margin="0,0,0,4" />
                <ListBox x:Name="RecordList" />
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>
            <ContentControl Style="{StaticResource Etched}" Grid.Column="2" Margin="8,0,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Manufacturer Name:" Margin="0,0,0,2" />
                    <TextBox x:Name="NameBox" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveButton" Content="Save" Margin="0,0,8,0" />
                        <Button x:Name="NewButton" Content="New" Margin="0,0,8,0" />
                        <Button x:Name="DeleteButton" Content="Delete" />
                        <Button x:Name="CopyItemsButton" Content="Copy Items To..." Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="StatusLabel" Margin="0,10,0,0" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
