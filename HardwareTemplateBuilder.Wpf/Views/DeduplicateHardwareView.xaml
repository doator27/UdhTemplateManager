<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.DeduplicateHardwareView">
    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6"><TextBlock Text="Deduplicate" Style="{StaticResource CaptionText}"/></Border>

        <!-- Status bar -->
        <TextBlock DockPanel.Dock="Bottom"
                   x:Name="StatusLabel"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>

        <ScrollViewer>
            <StackPanel>

                <!-- ── Templates section ─────────────────────────────────────── -->
                <GroupBox Header="Templates" Margin="0,0,0,10">
                    <StackPanel>
                        
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
                            Finds templates that share an identical Online Link or Local File path.
                            Select which template to keep — all hardware item links will be re-pointed
                            to the kept template before the duplicates are deleted.
                        </TextBlock>
                        <ui:Stack Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ScanTemplatesButton"     Content="Scan for Duplicate Templates"/>
                            <Button x:Name="MergeAllTemplatesButton" Content="Merge All"  IsEnabled="False"/>
                        </ui:Stack>
                        <StackPanel x:Name="TplGroupsPanel" Margin="0,8,0,0"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
