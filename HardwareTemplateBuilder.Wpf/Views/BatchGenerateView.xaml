<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.BatchGenerateView">
    <DockPanel Margin="8">

        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource CaptionBar}"><TextBlock  Text="Batch Generate" Style="{StaticResource CaptionText}"/></Border>

        <!-- Status line (docked bottom so it is always visible) -->
        <TextBlock DockPanel.Dock="Bottom"
                   x:Name="StatusLabel"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>

        <!-- Live per-job results (hidden until the batch starts) -->
        <ContentControl Style="{StaticResource Etched}" DockPanel.Dock="Bottom"
                x:Name="ResultsBorder" Visibility="Collapsed"
                Margin="0,8,0,0">
            <DockPanel Margin="4">
                <TextBlock DockPanel.Dock="Top" Text="Results" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="ResultsList" MaxHeight="220"/>
            </DockPanel>
        </ContentControl>

        <!-- Progress area (hidden until running) -->
        <StackPanel DockPanel.Dock="Bottom"
                    x:Name="ProgressPanel" Visibility="Collapsed"
                    Margin="0,8,0,0">
            <ProgressBar x:Name="BatchProgressBar" Minimum="0" Height="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <!-- Filter / selection / run controls -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="IncludeInactiveCheck" Content="Include inactive jobs" Margin="0,0,16,0"/>
                <TextBlock Text="User:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="CreatorFilterCombo" ui:Watermark.Text="(Any)" MinWidth="140" Margin="0,0,16,0"/>
                <Button x:Name="SelectAllButton" Content="Select All" Margin="0,0,4,0"/>
                <Button x:Name="SelectNoneButton" Content="Select None" Margin="0,0,16,0"/>
                <TextBlock x:Name="SelectedCountLabel" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RelinkButton" Content="Relink Hardware &amp; Generate" Margin="0,0,8,0"/>
                <Button x:Name="StartButton" Content="Generate Selected" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <!-- Job list, checkbox per row, sorted oldest/never-generated first -->
        <ListBox x:Name="JobList"/>

    </DockPanel>
</UserControl>
