<ui:Win95Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
        x:Class="HardwareTemplateBuilder.Wpf.Views.ItemsToFixDialog"
        Title="Items to Fix"
        Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <ui:Stack DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button x:Name="GoToButton" Content="Go to Manufacturer →" IsDefault="True"/>
            <Button x:Name="CloseButton" Content="Close" IsCancel="True"/>
        </ui:Stack>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="These items were skipped during the last &quot;Add All to Job&quot; run. Select one and click &quot;Go to Manufacturer&quot; to fix and re-add it."/>

        <ListBox x:Name="ItemsList"/>
    </DockPanel>
</ui:Win95Window>
