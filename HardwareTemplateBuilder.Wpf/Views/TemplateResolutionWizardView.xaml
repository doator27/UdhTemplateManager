<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             xmlns:views="clr-namespace:HardwareTemplateBuilder.Wpf.Views"
             x:Class="HardwareTemplateBuilder.Wpf.Views.TemplateResolutionWizardView">
    <DockPanel Margin="8">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6">
            <TextBlock x:Name="ItemHeaderLabel" Style="{StaticResource CaptionText}"/>
        </Border>

        <!-- Navigation footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left"  x:Name="PrevButton"   Content="← Previous" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" x:Name="FinishButton" Content="Finish"      Visibility="Collapsed" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" x:Name="NextButton"   Content="Next →"      Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="WizardStatusLabel" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Scrollable body -->
        <ScrollViewer>
            <ui:Stack Spacing="8">

                <!-- Labels (read-only, set in item entry view) -->
                <ContentControl Style="{StaticResource Etched}" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Labels / Line Items:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ui:Stack x:Name="LabelsDisplayPanel" Spacing="2"/>
                        <TextBlock x:Name="NoLabelsHint" Text="(no custom labels — will use model number)"
                                   Foreground="{StaticResource ShadowBrush}" FontStyle="Italic" FontSize="11"/>
                    </StackPanel>
                </ContentControl>

                <!-- Status panel (shown for both cases) -->
                <TextBlock x:Name="ItemStatusLabel" TextWrapping="Wrap" FontStyle="Italic" Foreground="{StaticResource MutedTextBrush}"/>

                <!-- Linked templates list (Case A — matched item) -->
                <GroupBox Header="Templates already linked to this item" x:Name="MatchedPanel" Visibility="Collapsed">
                    <StackPanel>
                        
                        <ListBox x:Name="LinkedTemplatesList" Height="80"/>

                        <!-- Only visible when importing job-specific templates from another job -->
                        <StackPanel x:Name="ImportedTemplatesSection" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock Text="Job-specific templates to import:" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox x:Name="ImportedTemplatesList" Height="80"/>
                            <Button x:Name="RemoveImportedTemplateButton" Content="Remove Selected"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Template add form (Case B — new item) -->
                <GroupBox Header="Add Templates for this new item" x:Name="NewItemPanel" Visibility="Collapsed">
                    <StackPanel>
                        

                        <Grid ui:GridEx.Columns="*,*" ui:GridEx.Rows="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              Margin="0,0,0,6">
                            <!-- Row 0–1: Template # (full width) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Template #:" Margin="0,0,0,2"/>
                            <TextBox   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TplNumberBox" Margin="0,0,0,4"/>

                            <!-- Row 2: Job-specific toggle -->
                            <CheckBox  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TplJobSpecificCheck"
                                       Content="Job-specific (hidden from other jobs' template searches)"
                                       Margin="0,0,0,8"/>

                            <!-- Row 3–4: Description | Door Material -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:"   Margin="0,0,8,2"/>
                            <ComboBox  Grid.Row="4" Grid.Column="0" x:Name="TplDescCombo"   HorizontalAlignment="Stretch" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Door Material:" Margin="0,0,0,2"/>
                            <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="TplMaterialCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                            <!-- Row 5–6: Num Pages | Pages To Print -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Num Pages:"     Margin="0,0,8,2"/>
                            <TextBox   Grid.Row="6" Grid.Column="0" x:Name="TplNumPagesBox" Text="1" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Pages To Print:" Margin="0,0,0,2"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TplPagesBox"    ui:Watermark.Text="e.g. 1  or  1,3-5" Margin="0,0,0,8"/>

                            <!-- Row 7–8: Pages To Rotate | Rotation Direction -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pages To Rotate:" Margin="0,0,8,2"/>
                            <TextBox   Grid.Row="8" Grid.Column="0" x:Name="TplPagesToRotateBox" ui:Watermark.Text="optional, e.g. 2,4" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Rotation Direction (°):" Margin="0,0,0,2"/>
                            <TextBox   Grid.Row="8" Grid.Column="1" x:Name="TplRotationDirectionBox" ui:Watermark.Text="e.g. 90 or -90" Margin="0,0,0,8"/>

                            <!-- Row 9–10: Online Link | Local File -->
                            <TextBlock Grid.Row="9"  Grid.Column="0" Text="Online Link (optional):" Margin="0,0,8,2"/>
                            <TextBox   Grid.Row="10" Grid.Column="0" x:Name="TplOnlineLinkBox" ui:Watermark.Text="https://..." Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="9"  Grid.Column="1" Text="Local File (optional):" Margin="0,0,0,2"/>
                            <Grid      Grid.Row="10" Grid.Column="1" ui:GridEx.Columns="*,Auto">
                                <TextBox Grid.Column="0" x:Name="TplLocalLinkBox" ui:Watermark.Text="Path to PDF..."/>
                                <Button  Grid.Column="1" x:Name="TplBrowseButton" Content="..." Width="32" MinWidth="0" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>

                        <Button x:Name="AddTemplateButton" Content="Add Template" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock x:Name="AddTemplateStatusLabel" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <TextBlock Text="Staged templates:" FontWeight="Bold" Margin="0,4,0,4"/>
                        <ListBox x:Name="PendingTemplatesList" Height="100"/>
                        <Button x:Name="RemovePendingTemplateButton" Content="Remove Selected" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                        <!-- Search for an existing template by partial number -->
                        <Button x:Name="ToggleSearchButton" Content="Search for existing template…"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <GroupBox Header="Search existing templates for this manufacturer" x:Name="SearchExistingPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <StackPanel>
                                
                                <Grid ui:GridEx.Columns="Auto,*,Auto,*" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="Template #:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox   Grid.Column="1" x:Name="SearchTplNumBox" ui:Watermark.Text="partial number…"/>
                                    <TextBlock Grid.Column="2" Text="Description:" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <ComboBox  Grid.Column="3" x:Name="SearchTplDescCombo" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <Grid ui:GridEx.Columns="*,8,*" Margin="0,0,0,6">
                                    <ListBox Grid.Column="0" x:Name="SearchTplResultsList" Height="140"/>
                                    <views:TemplatePreviewPanel Grid.Column="2" x:Name="SearchTplPreviewPanel" Height="140"/>
                                </Grid>
                                <ui:Stack Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="StageSearchResultButton" Content="Stage Selected"/>
                                </ui:Stack>
                                <TextBlock x:Name="SearchTplStatusLabel" Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>

            </ui:Stack>
        </ScrollViewer>
    </DockPanel>
</UserControl>
