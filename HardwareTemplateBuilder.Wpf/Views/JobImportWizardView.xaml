<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
			 x:Class="HardwareTemplateBuilder.Wpf.Views.JobImportWizardView">
	<DockPanel Margin="8">

		<Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6"><TextBlock Text="Import Jobs Wizard" Style="{StaticResource CaptionText}"/></Border>

		<TextBlock DockPanel.Dock="Bottom"
				   x:Name="StatusLabel"
				   Foreground="{StaticResource DangerBrush}"
				   TextWrapping="Wrap"
				   Margin="0,4,0,0"/>

		<!-- ═══ Step 1: pick legacy file ═══ -->
		<StackPanel x:Name="PickFilePanel" DockPanel.Dock="Top">
			<TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
				Compares every job in a legacy SQLite database against this master database.
				Jobs that are already identical are skipped automatically. For each job that is
				new, or already exists but is missing some hardware, you'll be shown exactly what
				would be added and can accept or skip it individually — nothing is written until
				you accept a job.
			</TextBlock>
			<Button x:Name="BrowseButton" Content="Browse for Legacy Database..." HorizontalAlignment="Left"/>

			<StackPanel x:Name="UserFilterPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
				<TextBlock Text="Filter by creator:" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<ComboBox x:Name="UserFilterComboBox" MinWidth="200"/>
				<Button x:Name="ContinueAfterUserFilterButton" Content="Continue" Margin="8,0,0,0"/>
			</StackPanel>
		</StackPanel>

		<!-- ═══ Step 2: summary before stepping through ═══ -->
		<StackPanel x:Name="SummaryPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8">
			<TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
			<Button x:Name="StartReviewButton" Content="Start Review" HorizontalAlignment="Left"/>
		</StackPanel>

		<!-- ═══ Step 3: per-job review ═══ -->
		<Grid x:Name="ReviewPanel" DockPanel.Dock="Top" Visibility="Collapsed" ui:GridEx.Rows="Auto,Auto,*,Auto">

			<TextBlock Grid.Row="0" x:Name="ProgressLabel" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>

			<ContentControl Style="{StaticResource Etched}" Grid.Row="1" Padding="10" Margin="0,0,0,8">
				<StackPanel>
					<TextBlock x:Name="JobHeaderText" FontWeight="Bold" Margin="0,0,0,4"/>
					<TextBlock x:Name="JobStatusText" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
					<TextBlock x:Name="JobNewRecordsText" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
				</StackPanel>
			</ContentControl>

			<ContentControl Style="{StaticResource Etched}" Grid.Row="2" Padding="8">
				<DockPanel>
					<TextBlock DockPanel.Dock="Top" Text="Hardware lines to add:" FontWeight="Bold" Margin="0,0,0,4"/>
					<ListBox x:Name="HardwareLinesList"/>
				</DockPanel>
			</ContentControl>

			<StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
				<Button x:Name="AcceptButton" Content="Accept This Job" Margin="0,0,8,0"/>
				<Button x:Name="SkipButton" Content="Skip This Job" Margin="0,0,8,0"/>
			</StackPanel>
		</Grid>

		<!-- ═══ Step 4: final summary ═══ -->
		<StackPanel x:Name="FinishPanel" DockPanel.Dock="Top" Visibility="Collapsed">
			<TextBlock x:Name="FinishSummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>
			<Button x:Name="DoneButton" Content="Done" HorizontalAlignment="Left"/>
		</StackPanel>

	</DockPanel>
</UserControl>
