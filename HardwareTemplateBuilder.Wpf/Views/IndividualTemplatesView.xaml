<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.IndividualTemplatesView">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6"><TextBlock Text="Individual Templates" Style="{StaticResource CaptionText}"/></Border>

        <!-- Add / edit form -->
        <ContentControl Style="{StaticResource Etched}" DockPanel.Dock="Top" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <Grid ui:GridEx.Columns="*,*" ui:GridEx.Rows="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer:" Margin="0,0,8,2"/>
                    <ComboBox Grid.Row="1" Grid.Column="0" x:Name="ManufacturerCombo" HorizontalAlignment="Stretch" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Description:" Margin="0,0,0,2"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DescriptionCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Template Number:" Margin="0,0,8,2"/>
                    <TextBox Grid.Row="3" Grid.Column="0" x:Name="TemplateNumberBox" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Num Pages:" Margin="0,0,0,2"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="NumPagesBox" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Pages To Print:" Margin="0,0,8,2"/>
                    <TextBox Grid.Row="5" Grid.Column="0" x:Name="PagesToPrintBox" ui:Watermark.Text="e.g. 1,3-5,8" Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Pages To Rotate:" Margin="0,0,0,2"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="PagesToRotateBox" ui:Watermark.Text="e.g. 2,4 (optional)" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Rotation Direction (degrees):" Margin="0,0,8,2"/>
                    <TextBox Grid.Row="7" Grid.Column="0" x:Name="RotationDirectionBox" ui:Watermark.Text="e.g. 90 or -90" Margin="0,0,8,8"/>

                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Door Material:" Margin="0,0,0,2"/>
                    <ComboBox Grid.Row="7" Grid.Column="1" x:Name="DoorMaterialCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Online Link (URL):" Margin="0,0,8,2"/>
                    <TextBox Grid.Row="9" Grid.Column="0" x:Name="OnlineLinkBox" ui:Watermark.Text="https://..." Margin="0,0,8,8"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Local Link (file path):" Margin="0,0,0,2"/>
                    <Grid Grid.Row="9" Grid.Column="1" ui:GridEx.Columns="*,Auto" Margin="0,0,0,8">
                        <TextBox Grid.Column="0" x:Name="LocalLinkBox"/>
                        <Button Grid.Column="1" x:Name="BrowseLocalLinkButton" Content="..." Width="30" MinWidth="0" Margin="4,0,0,0"/>
                    </Grid>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="SaveButton" Content="Save" Margin="0,0,8,0"/>
                    <Button x:Name="NewButton" Content="New" Margin="0,0,8,0"/>
                    <Button x:Name="DeleteButton" Content="Delete"/>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}"/>
            </StackPanel>
        </ContentControl>

        <!-- Search existing templates: Manufacturer / Description (cascading, multi-select)
             / Template Number (filtered by both) — selecting a template number populates the
             form above for editing. -->
        <Grid ui:GridEx.Columns="*,*,*">
            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock DockPanel.Dock="Top" Text="Manufacturer" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="MfrList" SelectionMode="Extended"/>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="0,0,4,0">
                <TextBlock DockPanel.Dock="Top" Text="Description" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="DescList" SelectionMode="Extended"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Template Number" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox DockPanel.Dock="Top" x:Name="TemplateNumberSearchBox" ui:Watermark.Text="Search template number..." Margin="0,0,0,4"/>
                <ListBox x:Name="TemplateNumberList"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
