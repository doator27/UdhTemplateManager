<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.RefreshTemplatesView">
    <DockPanel Margin="8">

        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6"><TextBlock Text="Refresh Templates" Style="{StaticResource CaptionText}"/></Border>

        <!-- Status line (docked bottom so it is always visible) -->
        <TextBlock DockPanel.Dock="Bottom"
                   x:Name="StatusLabel"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0"/>

        <!-- Info + start/cancel controls -->
        <ContentControl Style="{StaticResource Etched}" DockPanel.Dock="Top"
                Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                    Downloads the latest version of every template that has an Online Link, saves it
                    to the active user's Default Template Save Location, and updates the Local Link
                    field on success.  Failures are listed at the bottom.
                    JobTemplateSnapshot records are never modified.
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton"  Content="Start Refresh" Margin="0,0,8,0"/>
                    <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="EstimateLabel" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </ContentControl>

        <!-- Progress area (hidden until refresh starts) -->
        <StackPanel DockPanel.Dock="Top"
                    x:Name="ProgressPanel" Visibility="Collapsed"
                    Margin="0,0,0,8">
            <ProgressBar x:Name="RefreshProgress"
                         IsIndeterminate="True"
                         Height="14" Margin="0,0,0,4"/>
            <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBlock x:Name="ElapsedText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Results area (fills remaining space; hidden until refresh completes) -->
        <ScrollViewer x:Name="ResultsPanel" Visibility="Collapsed">
            <StackPanel Margin="0,4,0,0">
                <TextBlock x:Name="SummaryLabel" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock x:Name="TimingSummaryLabel" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>

                <StackPanel x:Name="SlowDownloadsPanel" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock x:Name="SlowDownloadsLabel"
                               Foreground="{StaticResource WarningBrush}" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <ListBox x:Name="SlowDownloadsList" MaxHeight="200" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimingReportPathLabel" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="OpenTimingReportButton" Content="Open Timing Report" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Failure list (hidden when there are no failures) -->
                <StackPanel x:Name="FailuresPanel" Visibility="Collapsed">
                    <TextBlock x:Name="FailuresLabel"
                               Foreground="{StaticResource DangerBrush}" FontWeight="Bold"
                               Margin="0,0,0,4"/>
                    <ListBox x:Name="FailuresList" MaxHeight="300" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ReportPathLabel" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="OpenReportButton" Content="Open Report" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="NoFailuresLabel"
                           Text="All templates refreshed successfully."
                           Foreground="{StaticResource SuccessBrush}"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
