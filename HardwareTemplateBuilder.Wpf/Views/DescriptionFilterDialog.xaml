<ui:Win95Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
		x:Class="HardwareTemplateBuilder.Wpf.Views.DescriptionFilterDialog"
		Title="Filter Descriptions"
		Width="360"
		SizeToContent="Height"
		MaxHeight="640"
		WindowStartupLocation="CenterOwner"
		ResizeMode="CanResizeWithGrip">
	<DockPanel Margin="12">
		<ui:Stack DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
					Spacing="8" Margin="0,10,0,0">
			<Button x:Name="OkButton"     Content="OK" IsDefault="True"/>
			<Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
		</ui:Stack>

		<TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
				   Text="Choose which descriptions to include on the cover sheet for this manufacturer."/>

		<CheckBox DockPanel.Dock="Top" x:Name="SelectAllCheckBox" Content="Select All" Margin="0,0,0,8"/>

		<ContentControl Style="{StaticResource Sunken}" Padding="4,0">
		<ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
			<ItemsControl x:Name="DescriptionsList">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2,0,2"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
		</ContentControl>
	</DockPanel>
</ui:Win95Window>
