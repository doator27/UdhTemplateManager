<ui:Win95Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
        xmlns:views="clr-namespace:HardwareTemplateBuilder.Wpf.Views"
        x:Class="HardwareTemplateBuilder.Wpf.Views.CatalogLookupWindow"
        Title="Look Up in Product Catalog"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6">
            <TextBlock x:Name="HeaderText" Text="Look Up in Product Catalog" Style="{StaticResource CaptionText}"/>
        </Border>

        <Grid DockPanel.Dock="Top" ui:GridEx.Columns="Auto,*,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Callout:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="CalloutBox" ui:Watermark.Text="Model number and options, e.g. 4040XP EDA RW/PA"/>
            <Button Grid.Column="2" x:Name="LookUpButton" Content="Look Up" Margin="6,0,0,0" IsDefault="True"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ui:Stack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button x:Name="LinkButton" Content="Link This Template" IsEnabled="False" Visibility="Collapsed"/>
                <Button x:Name="UseButton" Content="Use This Template #" IsEnabled="False" Visibility="Collapsed"/>
                <Button x:Name="CloseButton" Content="Close" IsCancel="True"/>
            </ui:Stack>
            <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>

        <Grid ui:GridEx.Columns="2*,6,3*">
            <Grid Grid.Column="0" ui:GridEx.Rows="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Text="Catalog pages (best first):" Margin="0,0,0,2"/>
                <ListBox Grid.Row="1" x:Name="HitsList" FontSize="11"/>
                <TextBlock Grid.Row="2" Text="Template numbers on this page:" Margin="0,8,0,2"/>
                <ListBox Grid.Row="3" x:Name="TemplatesList" FontSize="11" Height="80"/>
                <TextBlock Grid.Row="4" Text="On the page:" Margin="0,8,0,2"/>
                <TextBox Grid.Row="5" x:Name="SnippetBox" IsReadOnly="True" TextWrapping="Wrap" Height="90" FontFamily="Courier New" FontSize="11" VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <views:TemplatePreviewPanel Grid.Column="2" x:Name="PreviewPanel"/>
        </Grid>
    </DockPanel>
</ui:Win95Window>
