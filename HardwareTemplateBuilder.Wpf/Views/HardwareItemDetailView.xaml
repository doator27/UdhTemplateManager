<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
			 xmlns:views="clr-namespace:HardwareTemplateBuilder.Wpf.Views"
			 x:Class="HardwareTemplateBuilder.Wpf.Views.HardwareItemDetailView">
	<DockPanel Margin="8">
		<!-- Top: nav buttons + item title -->
		<DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
			<Button DockPanel.Dock="Left" x:Name="BackButton" Content="&#8592; Back to Hardware" Margin="0,0,12,0"/>
			<Border  Style="{StaticResource CaptionBar}"><TextBlock x:Name="ItemTitleLabel"  Style="{StaticResource CaptionText}"/></Border>
		</DockPanel>

		<!-- Linked Templates list (fixed, always visible) -->
		<GroupBox Header="Linked Templates" DockPanel.Dock="Top" Margin="0,0,0,8">
			<StackPanel>
				
				<TextBlock Text="Select a template below to edit its fields, or remove it." Style="{StaticResource Hint}" Margin="0,0,0,4"/>
				<ListBox x:Name="LinkedTemplatesList" Height="110" Margin="0,0,0,8"/>
				<Button x:Name="RemoveTemplateButton" Content="Remove Selected" HorizontalAlignment="Left"/>
				<TextBlock x:Name="RemoveStatusLabel" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}"/>
			</StackPanel>
		</GroupBox>

		<!-- Three ways to add a template, as tabs so the PDF previews get real room to breathe -->
		<TabControl x:Name="AddTemplateTabs">
			<TabItem Header="Add Template">
				<ScrollViewer>
					<StackPanel Margin="0,8,0,0">
						<TextBlock x:Name="AddPanelHeader" Text="Add Template" FontWeight="Bold" Margin="0,0,0,8"/>
						<Grid ui:GridEx.Columns="*,*" ui:GridEx.Rows="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
							<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Template #:" Margin="0,0,0,2"/>
							<TextBox   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AddTemplateNumBox" Margin="0,0,8,8"/>
							<TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" Margin="0,0,8,2"/>
							<TextBlock Grid.Row="2" Grid.Column="1" Text="Door Material:" Margin="0,0,0,2"/>
							<ComboBox  Grid.Row="3" Grid.Column="0" x:Name="AddDescCombo" HorizontalAlignment="Stretch" Margin="0,0,8,8"/>
							<ComboBox  Grid.Row="3" Grid.Column="1" x:Name="AddDoorMatCombo" HorizontalAlignment="Stretch" Margin="0,0,8,8"/>
							<TextBlock Grid.Row="4" Grid.Column="0" Text="Num Pages:" Margin="0,0,8,2"/>
							<TextBlock Grid.Row="4" Grid.Column="1" Text="Pages To Print:" Margin="0,0,8,2"/>
							<TextBox   Grid.Row="5" Grid.Column="0" x:Name="AddNumPagesBox" Text="" Margin="0,0,8,8"/>
							<TextBox   Grid.Row="5" Grid.Column="1" x:Name="AddPagesToPrintBox" Text="" ui:Watermark.Text="blank = all pages" Margin="0,0,8,8"/>
							<TextBlock Grid.Row="6" Grid.Column="0" Text="Pages To Rotate (optional):" Margin="0,0,0,2"/>
							<TextBlock Grid.Row="6" Grid.Column="1" Text="Rotation Direction (degrees):" Margin="0,0,8,2"/>
							<TextBox   Grid.Row="7" Grid.Column="0" x:Name="AddPagesToRotateBox" ui:Watermark.Text="e.g. 1,3-5" Margin="0,0,8,8"/>
							<TextBox   Grid.Row="7" Grid.Column="1" x:Name="AddRotationDirectionBox" Text="0" Margin="0,0,8,8"/>
							<TextBlock Grid.Row="8" Grid.Column="0" Text="Online Link (optional):" Margin="0,0,0,2"/>
							<TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Text="Local File (optional):" Margin="0,0,0,2"/>
							<Grid Grid.Row="9" Grid.Column="0" ui:GridEx.Columns="*,Auto" Margin="0,0,8,8">
								<TextBox Grid.Column="0" x:Name="AddOnlineLinkBox" ui:Watermark.Text="https://..."/>
								<Button Grid.Column="1" x:Name="FindOnlineButton" Content="Find Online..." Margin="6,0,0,0"/>
							</Grid>
							<Grid Grid.Row="9" Grid.Column="1" ui:GridEx.Columns="*,Auto">
								<TextBox Grid.Column="0" x:Name="AddLocalLinkBox" ui:Watermark.Text="Path to PDF..." Margin="0,0,8,8" />
								<Button Grid.Column="1" x:Name="BrowseLocalLinkButton" Content="Browse..." HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,8"/>
							</Grid>
						</Grid>
						<ui:Stack Orientation="Horizontal" Margin="0,8,0,0" Spacing="8">
							<Button x:Name="AddTemplateButton" Content="Add / Link Template" HorizontalAlignment="Left"/>
							<Button x:Name="SaveTemplateChangesButton" Content="Save Changes" HorizontalAlignment="Left" Visibility="Collapsed"/>
							<Button x:Name="CancelEditButton" Content="Cancel Edit" HorizontalAlignment="Left" Visibility="Collapsed"/>
							<Button x:Name="RequestedFromManufacturerButton" Content="Requested from Manufacturer" HorizontalAlignment="Left"/>
						</ui:Stack>
						<TextBlock x:Name="AddStatusLabel" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}"/>
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="Search Existing Templates">
				<Grid ui:GridEx.Rows="Auto,*,Auto,Auto" Margin="0,8,0,0">
					<Grid Grid.Row="0" ui:GridEx.Columns="*,*" Margin="0,0,0,8">
						<ComboBox Grid.Column="0" x:Name="SearchDescCombo" HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
						<TextBox  Grid.Column="1" x:Name="SearchTemplateNumBox" ui:Watermark.Text="Template #"/>
					</Grid>
					<Grid Grid.Row="1" ui:GridEx.Columns="*,8,*" Margin="0,0,0,8">
						<ListBox Grid.Column="0" x:Name="TemplateSearchList"/>
						<views:TemplatePreviewPanel Grid.Column="2" x:Name="SearchPreviewPanel"/>
					</Grid>
					<Button Grid.Row="2" x:Name="LinkButton" Content="Link Selected" HorizontalAlignment="Left"/>
					<TextBlock Grid.Row="3" x:Name="LinkStatusLabel" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}"/>
				</Grid>
			</TabItem>

			<TabItem Header="Import From Another Item">
				<Grid ui:GridEx.Rows="Auto,Auto,*,Auto,Auto" Margin="0,8,0,0">
					<TextBlock Grid.Row="0" Text="Pick another hardware item with the same manufacturer and description, select templates below, then import copies into this item. Imported copies are independent and can be edited without affecting the source item."
							   Style="{StaticResource Hint}" Margin="0,0,0,8"/>
					<ComboBox Grid.Row="1" x:Name="ImportSourceItemCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
					<Grid Grid.Row="2" ui:GridEx.Columns="*,8,*" Margin="0,0,0,8">
						<ListBox Grid.Column="0" x:Name="ImportTemplatesList" SelectionMode="Extended"/>
						<views:TemplatePreviewPanel Grid.Column="2" x:Name="ImportPreviewPanel"/>
					</Grid>
					<Button Grid.Row="3" x:Name="ImportSelectedButton" Content="Import Selected" HorizontalAlignment="Left"/>
					<TextBlock Grid.Row="4" x:Name="ImportStatusLabel" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}"/>
				</Grid>
			</TabItem>
		</TabControl>
	</DockPanel>
</UserControl>
