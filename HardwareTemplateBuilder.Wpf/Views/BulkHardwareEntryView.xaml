<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.BulkHardwareEntryView">
    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"  x:Name="BackButton" Content="← Back to Hub" Margin="0,0,8,0"/>
            <ui:Stack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button x:Name="SortLikeCoverSheetButton" Content="Sort Like Cover Sheet"/>
                <Button x:Name="GenerateCoverSheetButton" Content="Generate Cover Sheet"/>
                <Button x:Name="SaveButton" Content="Save"/>
            </ui:Stack>
            <Border  Style="{StaticResource CaptionBar}"><TextBlock x:Name="HeaderLabel"  Style="{StaticResource CaptionText}"/></Border>
        </DockPanel>

        <!-- Status label -->
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusLabel" Margin="0,6,0,0"
                   VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <!-- Item cards with Add button pinned below the last card -->
        <ScrollViewer>
            <ui:Stack Spacing="8">
                <ui:Stack x:Name="ItemsPanel" Spacing="8"/>
                <Button x:Name="AddItemButton" Content="+ Add Item"
                        HorizontalAlignment="Left" Margin="0,2,0,0"/>
            </ui:Stack>
        </ScrollViewer>

    </DockPanel>
</UserControl>
