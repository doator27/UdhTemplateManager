<ui:Win95Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
        x:Class="HardwareTemplateBuilder.Wpf.Views.DescriptionPickerWindow"
        Title="Select Description"
        Width="420" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SelectButton" Content="Select" Width="80" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="InstructionLabel" Text="Double-click or select and click Select:" Margin="0,0,0,6"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusLabel" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TreeView x:Name="DescTree">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DescriptionText}"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</ui:Win95Window>
