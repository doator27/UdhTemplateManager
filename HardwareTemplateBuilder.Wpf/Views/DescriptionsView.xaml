<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.DescriptionsView">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}">
            <TextBlock Text="Descriptions" Style="{StaticResource CaptionText}"/>
        </Border>
        <CheckBox DockPanel.Dock="Top" x:Name="ShowInactiveCheck" Content="Show Inactive" Margin="0,6,0,6" HorizontalAlignment="Left"/>
        <Grid ui:GridEx.Columns="300,Auto,*">
            <!-- Left: tree + reorder buttons -->
            <DockPanel Grid.Column="0" MinWidth="180" Margin="0,0,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="MoveUpButton"   Content="▲ Up"   Margin="0,0,4,0"/>
                    <Button x:Name="MoveDownButton" Content="▼ Down" Margin="0,0,4,0"/>
                    <Button x:Name="IndentButton"   Content="→ Indent"   Margin="0,0,4,0"/>
                    <Button x:Name="UnindentButton" Content="← Unindent"/>
                </StackPanel>
                <TreeView x:Name="DescTree" MinHeight="200">
                    <!-- Expansion/selection live on the node objects so a tree rebuild can restore them -->
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayDescriptionText}"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>
            <!-- Right: form -->
            <ContentControl Style="{StaticResource Etched}" Grid.Column="2" Margin="8,0,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Name:" Margin="0,0,0,2"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ActiveCheckBox" Content="Active" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Button x:Name="SaveButton"        Content="Save"           Margin="0,0,8,0"/>
                        <Button x:Name="AddRootButton"     Content="+ Root Item"    Margin="0,0,8,0"/>
                        <Button x:Name="AddChildButton"    Content="+ Child"        Margin="0,0,8,0"/>
                        <Button x:Name="DeleteButton"      Content="Delete"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusLabel" Margin="0,10,0,0" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </DockPanel>
</UserControl>
