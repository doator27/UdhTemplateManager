<ui:Win95Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
        x:Class="HardwareTemplateBuilder.Wpf.Views.PdfImportWizardWindow"
        Title="Parse PDF into Bulk Add"
        Width="860" Height="640" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,8">
            <TextBlock x:Name="HeaderText" Text="Parse PDF into Bulk Add" Style="{StaticResource CaptionText}"/>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ui:Stack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button x:Name="BackButton" Content="&lt; Back" IsEnabled="False"/>
                <Button x:Name="NextButton" Content="Next &gt;" IsEnabled="False" IsDefault="True"/>
                <Button x:Name="FinishButton" Content="Add to Bulk Add" IsEnabled="False"/>
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            </ui:Stack>
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
        </DockPanel>

        <Grid>
            <!-- Page 1: summary -->
            <DockPanel x:Name="SummaryPanel">
                <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8" Text="Reading the PDF..."/>
                <CheckBox DockPanel.Dock="Bottom" x:Name="ReviewAllCheck" Margin="0,8,0,0"
                          Content="Also step through the items that were identified automatically"/>
                <ListBox x:Name="SummaryList" FontFamily="Consolas" FontSize="11"/>
            </DockPanel>

            <!-- Similar callouts: sort them into items -->
            <DockPanel x:Name="ClusterPanel" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" x:Name="ClusterIntro" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <GroupBox DockPanel.Dock="Bottom" Header="Sort the ticked callouts" Padding="6" Margin="0,8,0,0">
                    <ui:Stack Spacing="6">
                        <TextBlock x:Name="ClusterProgress" TextWrapping="Wrap" FontWeight="Bold"/>
                        <WrapPanel>
                            <Button x:Name="SameItemButton" Content="Ticked Are the Same Item" Margin="0,0,6,6"/>
                            <Button x:Name="EachItemButton" Content="Each Ticked Is Its Own Item" Margin="0,0,6,6"/>
                            <Button x:Name="LeaveOutButton" Content="Leave Ticked Out" Margin="0,0,6,6"/>
                            <Button x:Name="ResetClusterButton" Content="Start Over" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </ui:Stack>
                </GroupBox>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ui:Stack x:Name="ClusterList" Spacing="4"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Page 2..n: one callout -->
            <DockPanel x:Name="StepPanel" Visibility="Collapsed">
                <GroupBox DockPanel.Dock="Top" Header="From the PDF" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock x:Name="SourceText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,4,0,0" FontStyle="Italic"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox DockPanel.Dock="Top" x:Name="CatalogPanel" Header="From the product catalog" Padding="6" Margin="0,0,0,8" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="CatalogButton" Content="Catalog Page..." VerticalAlignment="Top" Margin="8,0,0,0"/>
                        <TextBlock x:Name="CatalogText" TextWrapping="Wrap"/>
                    </DockPanel>
                </GroupBox>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" x:Name="AssemblyButton" Content="Make Assembly..." VerticalAlignment="Top" Margin="8,0,0,0"/>
                    <TextBlock x:Name="AssemblyText" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource Hint}"
                               Text="Is this item an assembly with other items in its heading? Make Assembly... puts them on one line."/>
                </DockPanel>

                <ui:Stack DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,6">
                    <RadioButton x:Name="ExistingRadio" Content="Existing hardware item" GroupName="Mode" IsChecked="True"/>
                    <RadioButton x:Name="NewRadio" Content="New hardware item" GroupName="Mode"/>
                    <RadioButton x:Name="SkipRadio" Content="Leave this out" GroupName="Mode"/>
                </ui:Stack>

                <Grid DockPanel.Dock="Top" ui:GridEx.Columns="Auto,*" ui:GridEx.Rows="Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ManufacturerCombo" Margin="0,0,0,4" IsEditable="False"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LabelCaption" Text="Label:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="LabelBox" ui:Watermark.Text="Label on the job (blank = none)"/>
                </Grid>

                <GroupBox DockPanel.Dock="Top" x:Name="LabelsPanel" Header="Labels for the cover sheet (each ticked label is its own line; edit as needed)" Padding="6" Margin="0,0,0,6" Visibility="Collapsed">
                    <ui:Stack x:Name="LabelRows" Spacing="4"/>
                </GroupBox>

                <!-- New item fields -->
                <Grid DockPanel.Dock="Top" x:Name="NewPanel" ui:GridEx.Columns="Auto,*,Auto" ui:GridEx.Rows="Auto,Auto" Margin="0,0,0,6" Visibility="Collapsed">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Description:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="DescriptionBox" IsReadOnly="True" Margin="0,0,6,4"/>
                    <Button Grid.Row="0" Grid.Column="2" x:Name="PickDescriptionButton" Content="Choose..." Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Model number:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ModelBox"/>
                </Grid>

                <!-- Existing item list -->
                <DockPanel x:Name="ExistingPanel">
                    <TextBox DockPanel.Dock="Top" x:Name="SearchBox" ui:Watermark.Text="Search model numbers..." Margin="0,0,0,4"/>
                    <ListBox x:Name="ItemsList" FontSize="11"/>
                </DockPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</ui:Win95Window>
