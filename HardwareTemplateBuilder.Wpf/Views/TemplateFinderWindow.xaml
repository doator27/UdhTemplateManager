<ui:Win95Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
        xmlns:views="clr-namespace:HardwareTemplateBuilder.Wpf.Views"
        x:Class="HardwareTemplateBuilder.Wpf.Views.TemplateFinderWindow"
        Title="Find Template Online"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6">
            <TextBlock x:Name="HeaderText" Text="Find Template Online" Style="{StaticResource CaptionText}"/>
        </Border>
        <TextBlock DockPanel.Dock="Top" x:Name="InfoText" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
        <ContentControl DockPanel.Dock="Top" x:Name="CatalogPanel" Style="{StaticResource Etched}" Padding="8" Margin="0,0,0,6" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="CatalogButton" Content="Catalog Page..." VerticalAlignment="Top" Margin="8,0,0,0"/>
                <TextBlock x:Name="CatalogText" TextWrapping="Wrap"/>
            </DockPanel>
        </ContentControl>

        <!-- Search controls -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ui:Stack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                <Button x:Name="CheckLinkButton" Content="Check Link"/>
                <Button x:Name="SearchButton" Content="Search Again"/>
                <Button x:Name="StopButton" Content="Stop" IsEnabled="False"/>
                <Button x:Name="GoogleButton" Content="Search Google in Browser"/>
                <Button x:Name="SiteGoogleButton" Content="Search Mfr Site on Google"/>
            </ui:Stack>
            <TextBox x:Name="PasteBox" ui:Watermark.Text="Paste a link from your browser and click Check Link..."/>
        </DockPanel>

        <!-- Bottom: selected link + actions -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ui:Stack DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button x:Name="OpenLinkButton" Content="Open in Browser" IsEnabled="False"/>
                <Button x:Name="UseButton" Content="Use This Link" IsEnabled="False" IsDefault="True"/>
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            </ui:Stack>
            <TextBox x:Name="SelectedUrlBox" IsReadOnly="True" Margin="0,0,6,0"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusLabel" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <Grid ui:GridEx.Columns="2*,6,3*">
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="PDFs found (best first; * = mentions the number):" Margin="0,0,0,2"/>
                <ListBox x:Name="CandidatesList" FontSize="11"/>
            </DockPanel>
            <views:TemplatePreviewPanel Grid.Column="2" x:Name="PreviewPanel"/>
        </Grid>
    </DockPanel>
</ui:Win95Window>
