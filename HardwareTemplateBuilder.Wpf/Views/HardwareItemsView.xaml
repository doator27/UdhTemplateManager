<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.HardwareItemsView">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,6"><TextBlock Text="Hardware Items" Style="{StaticResource CaptionText}"/></Border>
        <Grid ui:GridEx.Columns="300,Auto,*">
            <!-- Left: search and list -->
            <DockPanel Grid.Column="0" MinWidth="180" Margin="0,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Manufacturer:" Margin="0,0,0,2"/>
                <ComboBox DockPanel.Dock="Top" x:Name="MfrCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                
                <TextBlock DockPanel.Dock="Top" Text="Description:" Margin="0,0,0,2"/>
                <ComboBox DockPanel.Dock="Top" x:Name="DescCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                
                <TextBlock DockPanel.Dock="Top" Text="Filter by Model:" Margin="0,0,0,2"/>
                <TextBox DockPanel.Dock="Top" x:Name="FilterBox" ui:Watermark.Text="Search model..." Margin="0,0,0,8"/>
                
                <CheckBox DockPanel.Dock="Top" x:Name="ShowInactiveCheck" Content="Show Inactive Items" Margin="0,0,0,8"/>
                
                <TextBlock DockPanel.Dock="Top" Text="Results:" Margin="0,0,0,2"/>
                <ListBox x:Name="RecordList"/>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns"/>
            <!-- Right: form -->
            <ScrollViewer Grid.Column="2" Margin="8,0,0,0">
                <GroupBox Header="Selected Item Details">
                    <StackPanel>
                        
                        <ContentControl Style="{StaticResource Etched}" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="SelectedMfrLabel" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SelectedDescLabel" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SelectedModelLabel" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SelectedFreqLabel"/>
                            </StackPanel>
                        </ContentControl>
                        
                        <Grid ui:GridEx.Columns="*,*" ui:GridEx.Rows="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer:" Margin="0,0,8,2"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" x:Name="ManufacturerCombo" HorizontalAlignment="Stretch" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Description:" Margin="0,0,0,2"/>
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" x:Name="PickDescriptionButton" Content="Pick" Width="46" MinWidth="0" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource Etched}" Padding="5,3">
                                    <TextBlock x:Name="DescriptionLabel" Text="(none)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </ContentControl>
                            </DockPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model Number:" Margin="0,0,8,2"/>
                            <TextBox Grid.Row="3" Grid.Column="0" x:Name="ModelNumberBox" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Frequency (read-only):" Margin="0,0,0,2"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="FrequencyBox" IsReadOnly="True" Background="{StaticResource FaceBrush}" Margin="0,0,0,8"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" x:Name="IsActiveCheck" Content="Active" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Remarks (optional):" Margin="0,0,0,2"/>
                            <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RemarksBox"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="SaveButton"     Content="Save"      Margin="0,0,8,0"/>
                            <Button x:Name="NewButton"      Content="New"       Margin="0,0,8,0"/>
                            <Button x:Name="DeleteButton"   Content="Delete"    Margin="0,0,8,0"/>
                            <Button x:Name="OpenItemButton" Content="Open Item"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusLabel" Margin="0,8,0,0" Foreground="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </GroupBox>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
