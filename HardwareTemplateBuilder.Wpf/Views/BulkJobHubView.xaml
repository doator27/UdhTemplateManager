<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
             x:Class="HardwareTemplateBuilder.Wpf.Views.BulkJobHubView">
    <DockPanel Margin="8">
        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"  x:Name="BackButton"     Content="← Change Manufacturers" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" x:Name="ContinueButton" Content="Continue to Templates →"/>
            <Border  Style="{StaticResource CaptionBar}"><TextBlock x:Name="HeaderLabel"  Style="{StaticResource CaptionText}"/></Border>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusLabel" Margin="0,6,0,0"
                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>

        <!-- Manufacturer cards (added in code-behind) -->
        <ScrollViewer>
            <ui:Stack x:Name="CardsPanel" Spacing="6"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
