<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
			 x:Class="HardwareTemplateBuilder.Wpf.Views.TransferJobView">
	<DockPanel Margin="8">

		<Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource CaptionBar}"><TextBlock  Text="Transfer Job" Style="{StaticResource CaptionText}"/></Border>

		<!-- Status line -->
		<TextBlock DockPanel.Dock="Bottom"
				   x:Name="StatusLabel"
				   Foreground="{StaticResource DangerBrush}"
				   TextWrapping="Wrap"
				   Margin="0,6,0,0"/>

		<!-- Filter / selection / transfer controls -->
		<StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">

			<Grid ui:GridEx.Columns="Auto,*" Margin="0,0,0,6">
				<TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<TextBox Grid.Column="1" x:Name="FilterBox" ui:Watermark.Text="Search job number, job name, customer, project manager, owner, or notes..."/>
			</Grid>

			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
				<CheckBox x:Name="IncludeInactiveCheck" Content="Include inactive jobs" Margin="0,0,16,0"/>
				<TextBlock Text="Owner:" VerticalAlignment="Center" Margin="0,0,4,0"/>
				<ComboBox x:Name="OwnerFilterCombo" ui:Watermark.Text="(Any)" MinWidth="140" Margin="0,0,16,0"/>
				<Button x:Name="SelectAllButton" Content="Select All" Margin="0,0,4,0"/>
				<Button x:Name="SelectNoneButton" Content="Select None" Margin="0,0,16,0"/>
				<TextBlock x:Name="SelectedCountLabel" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
			</StackPanel>

			<Grid ui:GridEx.Columns="Auto,*,Auto">
				<TextBlock Grid.Column="0" Text="Transfer to:" VerticalAlignment="Center" Margin="0,0,8,0"/>
				<ComboBox Grid.Column="1" x:Name="TransferToCombo" ui:Watermark.Text="Select destination user..." HorizontalAlignment="Left" MinWidth="200"/>
				<Button Grid.Column="2" x:Name="TransferButton" Content="Transfer Selected Job(s)" Margin="16,0,0,0"/>
			</Grid>

		</StackPanel>

		<!-- Job list, checkbox per row -->
		<ListBox x:Name="JobList"/>

	</DockPanel>
</UserControl>
