<ui:Win95Window x:Class="HardwareTemplateBuilder.Wpf.Views.ProfilePickerDialog"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui"
                Title="Welcome to Hardware Template Builder"
                Width="460" Height="460"
                WindowStartupLocation="CenterScreen"
                ResizeMode="NoResize">
    <DockPanel Margin="10">
        <!-- Win95 "Welcome" style banner -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CaptionBar}" Margin="0,0,0,8">
            <TextBlock Text="Who are you?" Style="{StaticResource CaptionText}"/>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="Select your user profile to continue." Margin="0,0,0,8"/>

        <GroupBox DockPanel.Dock="Top" Header="Existing profiles" Margin="0,0,0,8">
            <StackPanel>
                <ListBox x:Name="ProfileList" Height="120" Margin="0,0,0,8"/>
                <Button x:Name="SelectButton" Content="_Select Profile" HorizontalAlignment="Left" IsDefault="True"/>
                <TextBlock x:Name="SelectStatus" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Or create a new profile" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Name:" Margin="0,0,0,2"/>
                <TextBox x:Name="NewNameBox" Margin="0,0,0,8"/>
                <Button x:Name="CreateButton" Content="_Create &amp; Select" HorizontalAlignment="Left"/>
                <TextBlock x:Name="CreateStatus" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>
    </DockPanel>
</ui:Win95Window>
