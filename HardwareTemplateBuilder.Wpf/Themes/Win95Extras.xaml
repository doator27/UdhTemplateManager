<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:ui="clr-namespace:HardwareTemplateBuilder.Wpf.Ui">

    <!--
        Controls the Template Builder uses that SpecialJobLookup's theme (Win95.xaml) doesn't cover:
        windows, menus, radio buttons, trees, progress bars, plus the Template Builder's own
        dashboard button styles. Same palette and bevel rules as Win95.xaml, which is merged here so
        StaticResource references to its brushes and styles resolve. App.xaml merges only this file.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/HardwareTemplateBuilder.Wpf;component/Themes/Win95.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="InfoBrush" Color="#000080"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#806000"/>
    <SolidColorBrush x:Key="TooltipBrush" Color="#FFFFE1"/>

    <!-- ===== Windows ===== -->
    <!--
        Custom Windows 95 title bar. Win95Window (below) replaces the Windows 10/11 title bar with
        WindowChrome and draws its own: navy caption (gray when inactive), icon (click = system
        menu), bold white title, and bevelled minimize / maximize-restore / close buttons, inside a
        raised 3D window frame. Dragging, double-click-to-maximize, snapping, resizing and the
        right-click system menu are still handled by Windows. Ui/Win95Chrome.cs supplies the button
        commands, square corners on Windows 11 and the maximized-window margin.
    -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>

    <Style x:Key="CaptionIconButton" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"><ContentPresenter/></Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Win95Window" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource FaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="22" ResizeBorderThickness="4" GlassFrameThickness="0"
                                    CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="PART_Win95Root" Background="{StaticResource FaceBrush}">
                        <!-- Raised 3D window frame -->
                        <Border x:Name="Frame1" BorderBrush="{StaticResource DarkShadowBrush}" BorderThickness="0,0,1,1">
                            <Border x:Name="Frame2" BorderBrush="{StaticResource LightBrush}" BorderThickness="1,1,0,0">
                                <Border x:Name="Frame3" BorderBrush="{StaticResource ShadowBrush}" BorderThickness="0,0,1,1">
                                    <Border x:Name="Frame4" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0" Padding="2">
                                        <DockPanel>
                                            <!-- Title bar -->
                                            <Border x:Name="Caption" DockPanel.Dock="Top" Height="18" Margin="0,0,0,1"
                                                    Background="{StaticResource CaptionBrush}">
                                                <DockPanel Margin="2,0,2,0">
                                                    <Button x:Name="IconButton" DockPanel.Dock="Left" Style="{StaticResource CaptionIconButton}"
                                                            Command="{x:Static ui:Win95Chrome.ShowSystemMenuCommand}"
                                                            VerticalAlignment="Center" ToolTip="Window menu">
                                                        <Image Source="{TemplateBinding Icon}" Width="16" Height="16"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                    </Button>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" ToolTip="Minimize"
                                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                                                            <Path Data="M0,0 H6 V2 H0 Z" Margin="0,6,1,0"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        </Button>
                                                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" ToolTip="Maximize"
                                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                                                            <Path Data="M0,0 H9 V9 H0 Z M1,2 H8 V8 H1 Z" FillRule="EvenOdd"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        </Button>
                                                        <Button x:Name="RestoreButton" Style="{StaticResource CaptionButton}" ToolTip="Restore"
                                                                Visibility="Collapsed"
                                                                Command="{x:Static SystemCommands.RestoreWindowCommand}">
                                                            <Path Data="M0,3 H6 V9 H0 Z M1,5 H5 V8 H1 Z M2,0 H8 V6 H6 V5 H7 V2 H3 V3 H2 Z" FillRule="EvenOdd"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        </Button>
                                                        <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" ToolTip="Close"
                                                                Margin="2,0,0,0"
                                                                Command="{x:Static SystemCommands.CloseWindowCommand}">
                                                            <Path Data="M0,0 H2 L4,2 L6,0 H8 L5,3.5 L8,7 H6 L4,5 L2,7 H0 L3,3.5 Z"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" Margin="3,0,4,0"
                                                               VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource HighlightBrush}"/>
                                                </DockPanel>
                                            </Border>

                                            <!-- Window content -->
                                            <Grid Background="{TemplateBinding Background}">
                                                <AdornerDecorator>
                                                    <ContentPresenter/>
                                                </AdornerDecorator>
                                                <ResizeGrip x:Name="Grip" Visibility="Collapsed" IsTabStop="False"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            shell:WindowChrome.ResizeGripDirection="BottomRight"
                                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Caption" Property="Background" Value="{StaticResource ShadowBrush}"/>
                            <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource FaceBrush}"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Frame1" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Frame2" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Frame3" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Frame4" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="Frame4" Property="Padding" Value="0"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip"/>
                                <Condition Property="WindowState" Value="Normal"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Grip" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <!-- Dialogs (not in the taskbar) can't be minimized -->
                        <Trigger Property="ShowInTaskbar" Value="False">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bigger raised buttons on the dashboard tiles -->
    <Style x:Key="DashboardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="DashboardPrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardButton}">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Toolbar-style flat button: flat until hovered, then a thin raised edge -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Edge" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Edge" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#808080" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Presenter" Property="Margin" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Radio button (round, sunken) ===== -->
    <Style TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse StrokeThickness="1">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#808080" Offset="0.5"/>
                                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse x:Name="Well" Margin="1" StrokeThickness="1" Fill="{StaticResource WindowBrush}">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#000000" Offset="0.5"/>
                                        <GradientStop Color="#DFDFDF" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Ellipse x:Name="Dot" Width="4" Height="4" Fill="{StaticResource TextBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Well" Property="Fill" Value="{StaticResource FaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Menus and context menus (raised popup, navy highlight) ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border BorderBrush="{StaticResource DarkShadowBrush}" BorderThickness="0,0,1,1">
                        <Border BorderBrush="{StaticResource LightBrush}" BorderThickness="1,1,0,0">
                            <Border BorderBrush="{StaticResource ShadowBrush}" BorderThickness="0,0,1,1">
                                <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0"
                                        Background="{StaticResource FaceBrush}" Padding="1">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{StaticResource FaceBrush}"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Menu items: navy highlight. Top-level items (the menu bar) drop their popup below; items
         with a submenu show the Marlett arrow; checkable items show a check mark. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="18,3,18,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <TextBlock x:Name="Check" DockPanel.Dock="Left" Text="a" FontFamily="Marlett" FontSize="11"
                                           Margin="-14,0,4,0" Width="10" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="Arrow" DockPanel.Dock="Right" Text="4" FontFamily="Marlett" FontSize="11"
                                           Margin="16,0,-12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="False" PopupAnimation="None" Focusable="False">
                            <Border BorderBrush="{StaticResource DarkShadowBrush}" BorderThickness="0,0,1,1">
                                <Border BorderBrush="{StaticResource LightBrush}" BorderThickness="1,1,0,0">
                                    <Border BorderBrush="{StaticResource ShadowBrush}" BorderThickness="0,0,1,1">
                                        <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1,1,0,0"
                                                Background="{StaticResource FaceBrush}" Padding="1" MinWidth="140">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            <Setter TargetName="Bd" Property="Padding" Value="7,2"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="Bd" Property="Padding" Value="7,2"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etched line used for menu separators and dividers -->
    <Style TargetType="Separator">
        <Setter Property="Margin" Value="2,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border BorderBrush="{StaticResource ShadowBrush}" BorderThickness="0,1,0,0" Margin="{TemplateBinding Margin}">
                        <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,1,0,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF gives separators inside menus this key instead of the implicit Separator style -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>

    <!-- ===== Tree view (sunken white field, +/- boxes, navy header selection) ===== -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeView">
                    <Border BorderBrush="{StaticResource ShadowBrush}" BorderThickness="1,1,0,0">
                        <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,0,1,1">
                            <Border BorderBrush="{StaticResource DarkShadowBrush}" BorderThickness="1,1,0,0">
                                <Border BorderBrush="{StaticResource LightBrush}" BorderThickness="0,0,1,1"
                                        Background="{TemplateBinding Background}">
                                    <ScrollViewer Focusable="False" Padding="2" CanContentScroll="False"
                                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Border Width="9" Height="9" BorderBrush="{StaticResource ShadowBrush}" BorderThickness="1"
                                Background="{StaticResource WindowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid>
                                <Rectangle Width="5" Height="1" Fill="{StaticResource TextBrush}"/>
                                <Rectangle x:Name="Vertical" Width="1" Height="5" Fill="{StaticResource TextBrush}"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Vertical" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <Border x:Name="Bd" Grid.Column="1" HorizontalAlignment="Left" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource SelectionTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Progress bar (sunken, navy blocks) ===== -->
    <DrawingBrush x:Key="ProgressBlocks" TileMode="Tile" Viewport="0,0,10,1" ViewportUnits="Absolute" Viewbox="0,0,10,1" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#C0C0C0" Geometry="M0,0 H10 V1 H0 Z"/>
                <GeometryDrawing Brush="#000080" Geometry="M0,0 H8 V1 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="{StaticResource ShadowBrush}" BorderThickness="1,1,0,0">
                        <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,0,1,1"
                                Background="{StaticResource FaceBrush}" Padding="2">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource ProgressBlocks}"/>
                                <Border x:Name="Indeterminate" Background="{StaticResource ProgressBlocks}" Visibility="Collapsed"
                                        HorizontalAlignment="Left" Width="60"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Sweep">
                                    <Storyboard RepeatBehavior="Forever">
                                        <ThicknessAnimation Storyboard.TargetName="Indeterminate" Storyboard.TargetProperty="Margin"
                                                            From="-60,0,0,0" To="400,0,0,0" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Sweep"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Etched frame (a GroupBox without a caption) used for the Avalonia app's "panel" borders -->
    <Style x:Key="Etched" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid SnapsToDevicePixels="True">
                        <Border Margin="0,0,1,1" BorderBrush="{StaticResource ShadowBrush}" BorderThickness="1"/>
                        <Border Margin="1,1,0,0" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Misc ===== -->
    <Style TargetType="GroupBox" x:Key="PanelGroup" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Read-only text block that can be selected (Avalonia's SelectableTextBlock) -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}"/>
        <Setter Property="SelectionTextBrush" Value="{StaticResource SelectionTextBrush}"/>
        <Setter Property="SelectionOpacity" Value="1"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
