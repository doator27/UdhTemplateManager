<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.CustomersView">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Customers" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid ColumnDefinitions="250,*">
            <!-- Left: list panel -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Filter:" Margin="0,0,0,2" />
                <TextBox DockPanel.Dock="Top" Name="FilterBox" Watermark="Search..." Margin="0,0,0,4" />
                <ListBox Name="RecordList" />
            </DockPanel>
            <!-- Right: edit form -->
            <Border Grid.Column="1" Classes="panel" BorderBrush="#808080" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="Customer Name:" Margin="0,0,0,2" />
                    <TextBox Name="CustomerNameBox" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Name="SaveButton" Content="Save" Margin="0,0,8,0" />
                        <Button Name="NewButton" Content="New" Margin="0,0,8,0" />
                        <Button Name="DeleteButton" Content="Delete" />
                    </StackPanel>
                    <TextBlock Name="StatusLabel" Margin="0,10,0,0" Foreground="#800000" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
