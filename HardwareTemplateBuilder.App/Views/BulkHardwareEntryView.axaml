<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.BulkHardwareEntryView">
    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"  Name="BackButton" Content="← Back to Hub" Margin="0,0,8,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Name="GenerateCoverSheetButton" Content="Generate Cover Sheet" Padding="8,4"/>
                <Button Name="SaveButton" Content="Save"/>
            </StackPanel>
            <TextBlock Name="HeaderLabel" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Status label -->
        <TextBlock DockPanel.Dock="Bottom" Name="StatusLabel" Margin="0,6,0,0"
                   VerticalAlignment="Center" Foreground="#800000" TextWrapping="Wrap"/>

        <!-- Item cards with Add button pinned below the last card -->
        <ScrollViewer>
            <StackPanel Spacing="8">
                <StackPanel Name="ItemsPanel" Spacing="8"/>
                <Button Name="AddItemButton" Content="+ Add Item"
                        HorizontalAlignment="Left" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
