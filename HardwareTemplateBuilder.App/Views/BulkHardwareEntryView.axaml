<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.BulkHardwareEntryView">
    <DockPanel Margin="8">
        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Name="BackButton" Content="← Back to Job" Margin="0,0,8,0"/>
            <TextBlock DockPanel.Dock="Left" Text="Bulk Hardware Entry" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Bottom action bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left"  Name="AddRowButton"   Content="+ Add Row"   Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Name="ContinueButton" Content="Continue →"  IsEnabled="False"/>
            <TextBlock Name="StatusLabel" VerticalAlignment="Center" Foreground="#800000" TextWrapping="Wrap"/>
        </DockPanel>

        <!--
            Header and rows are both inside the ScrollViewer so they share
            exactly the same available width — no scrollbar-offset misalignment.
        -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Column header row — same column widths as data rows -->
                <Grid ColumnDefinitions="150,180,170,70,120,160,32" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Text="Manufacturer"  FontWeight="Bold" Margin="2,0"/>
                    <TextBlock Grid.Column="1" Text="Description"   FontWeight="Bold" Margin="2,0"/>
                    <TextBlock Grid.Column="2" Text="Model #"       FontWeight="Bold" Margin="2,0"/>
                    <TextBlock Grid.Column="3" Text="Match"         FontWeight="Bold" Margin="2,0"/>
                    <TextBlock Grid.Column="4" Text="Custom Label"  FontWeight="Bold" Margin="2,0"/>
                    <TextBlock Grid.Column="5" Text="Remarks"       FontWeight="Bold" Margin="2,0"/>
                </Grid>
                <!-- Data rows added in code-behind -->
                <StackPanel Name="RowsPanel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
