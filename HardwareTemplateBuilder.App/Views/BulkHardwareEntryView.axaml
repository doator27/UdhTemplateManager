<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.BulkHardwareEntryView">
    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left"  Name="BackButton" Content="← Back to Hub" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Name="SaveButton" Content="Save"/>
            <TextBlock Name="HeaderLabel" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Bottom action bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Name="AddItemButton" Content="+ Add Item" Margin="0,0,8,0"/>
            <TextBlock Name="StatusLabel" VerticalAlignment="Center" Foreground="#800000" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Item cards added in code-behind -->
        <ScrollViewer>
            <StackPanel Name="ItemsPanel" Spacing="8"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
