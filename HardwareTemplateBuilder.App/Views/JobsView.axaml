<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.JobsView">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Name="MainMenuButton" Content="⊞ Dashboard" Margin="0,0,12,0"/>
            <TextBlock Text="Jobs" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid ColumnDefinitions="260,*">
            <!-- Left: job list -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Filter:" Margin="0,0,0,2"/>
                <TextBox DockPanel.Dock="Top" Name="FilterBox" Watermark="Search..." Margin="0,0,0,4"/>
                <CheckBox DockPanel.Dock="Top" Name="ShowCompletedCheck" Content="Show completed" Margin="0,0,0,4"/>
                <ListBox Name="JobList"/>
            </DockPanel>
            <!-- Right: metadata form -->
            <ScrollViewer Grid.Column="1">
                <Border Classes="panel" BorderBrush="#808080" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Job Number:" Margin="0,0,8,2"/>
                            <TextBox   Grid.Row="1" Grid.Column="0" Name="JobNumberBox" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Job Name:" Margin="0,0,0,2"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Name="JobNameBox" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Customer:" Margin="0,0,8,2"/>
                            <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                                <Button DockPanel.Dock="Right" Name="AddCustomerButton" Content="+" Width="28" Margin="4,0,0,0"/>
                                <ComboBox Name="CustomerCombo" HorizontalAlignment="Stretch"/>
                            </DockPanel>
                            <DockPanel Grid.Row="4" Grid.Column="0" Name="NewCustomerPanel" IsVisible="False" Margin="0,4,8,0">
                                <Button DockPanel.Dock="Right" Name="CancelCustomerButton" Content="✕" Width="28" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Name="SaveCustomerButton"  Content="Add" Width="40" Margin="4,0,0,0"/>
                                <TextBox Name="NewCustomerBox" Watermark="New customer name..."/>
                            </DockPanel>

                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Project Manager:" Margin="0,0,0,2"/>
                            <DockPanel Grid.Row="3" Grid.Column="1">
                                <Button DockPanel.Dock="Right" Name="AddProjectManagerButton" Content="+" Width="28" Margin="4,0,0,0"/>
                                <ComboBox Name="ProjectManagerCombo" HorizontalAlignment="Stretch"/>
                            </DockPanel>
                            <DockPanel Grid.Row="4" Grid.Column="1" Name="NewProjectManagerPanel" IsVisible="False" Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Name="CancelProjectManagerButton" Content="✕" Width="28" Margin="4,0,0,0"/>
                                <Button DockPanel.Dock="Right" Name="SaveProjectManagerButton"  Content="Add" Width="40" Margin="4,0,0,0"/>
                                <TextBox Name="NewProjectManagerBox" Watermark="New project manager name..."/>
                            </DockPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Name="SaveButton"    Content="Save"     Margin="0,0,8,0"/>
                            <Button Name="NewButton"     Content="New"      Margin="0,0,8,0"/>
                            <Button Name="DeleteButton"  Content="Delete"   Margin="0,0,8,0"/>
                            <Button Name="OpenJobButton" Content="Open Job" Margin="0,0,8,0"/>
                            <Button Name="ToggleCompleteButton" Content="Mark Complete" Margin="0,0,0,0"/>
                        </StackPanel>
                        <TextBlock Name="StatusLabel" Margin="0,8,0,0" Foreground="#800000"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
