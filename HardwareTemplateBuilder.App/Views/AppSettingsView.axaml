<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.AppSettingsView">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="App Settings" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer>
            <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="12">

                <!-- Appearance -->
                <Border BorderBrush="#454952" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Appearance:" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#A7ADB8" FontSize="11"
                                   Text="Choose Light or Dark mode. Light mode uses a neutral gray/white palette similar to the standalone Template Lookup tool."
                                   Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Name="DarkThemeRadio" Content="Dark" GroupName="Theme" />
                            <RadioButton Name="LightThemeRadio" Content="Light" GroupName="Theme" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Template storage location -->
                <Border BorderBrush="#454952" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Template Storage Location:" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#A7ADB8" FontSize="11"
                                   Text="Shared folder where all template files are saved. All users on all machines must point to the same location (e.g. a network drive)."
                                   Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" Name="StorageLocationBox" Watermark="e.g. \\server\templates or /mnt/shared/templates" />
                            <Button Grid.Column="1" Name="BrowseButton" Content="Browse..." Width="80" Margin="6,0,0,0" />
                        </Grid>
                        <Button Name="SaveButton" Content="Save" HorizontalAlignment="Left" />
                        <TextBlock Name="StatusLabel" Margin="0,10,0,0" Foreground="#FF6B6B" />
                    </StackPanel>
                </Border>

                <!-- Database connection -->
                <Border BorderBrush="#454952" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Database Connection:" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#A7ADB8" FontSize="11"
                                   Text="The shared MySQL database used by all clients. Every workstation connects directly to the same server."
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Active connection:" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Name="CurrentDbPathLabel" TextWrapping="Wrap" Foreground="#A7ADB8"
                                   FontSize="11" Margin="0,0,0,4" />
                        <TextBlock Text="Pointer file:" FontSize="10" Margin="0,0,0,2" />
                        <TextBlock Name="PointerFilePathLabel" TextWrapping="Wrap" Foreground="#A7ADB8"
                                   FontSize="10" Margin="0,0,0,16" />

                        <TextBlock Text="Update connection string:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#A7ADB8" FontSize="11"
                                   Text="Example: Server=myserver;Port=3306;Database=hardware_templates;Uid=appuser;Pwd=secret;"
                                   Margin="0,0,0,6"/>
                        <TextBox Name="DbConnectPathBox" Watermark="Server=...;Port=3306;Database=...;Uid=...;Pwd=...;" Margin="0,0,0,8" />
                        <Button Name="DbConnectButton" Content="Connect" HorizontalAlignment="Left" />
                        <TextBlock Name="DbStatusLabel" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF6B6B" />
                    </StackPanel>
                </Border>

                <!-- Upload missing records from an old SQLite backup -->
                <Border BorderBrush="#454952" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Upload Missing Records from Old Database:" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#A7ADB8" FontSize="11"
                                   Text="Select an old SQLite database file (.db/.sqlite). Any records present in that file but missing from the active database will be added. Existing records are never changed or deleted."
                                   Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBox Grid.Column="0" Name="SqliteMergePathBox" Watermark="Path to old .db/.sqlite file" IsReadOnly="True" />
                            <Button Grid.Column="1" Name="BrowseSqliteButton" Content="Browse..." Width="80" Margin="6,0,0,0" />
                        </Grid>
                        <Button Name="UploadMissingRecordsButton" Content="Upload Missing Records" HorizontalAlignment="Left" />
                        <TextBlock Name="SqliteMergeStatusLabel" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF6B6B" />
                    </StackPanel>
                </Border>

                <!-- Requested-from-manufacturer placeholder template -->
                <Border BorderBrush="#454952" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Requested-from-Manufacturer Placeholder:" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#A7ADB8" FontSize="11"
                                   Text="The local PDF file used (linked as-is) when marking a hardware item's template as 'Requested from Manufacturer'."
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Placeholder PDF path:" Margin="0,0,0,2" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" Name="RequestedFromManufacturerPdfPathBox" Watermark="e.g. \\server\templates\placeholder.pdf" />
                            <Button Grid.Column="1" Name="BrowseRequestedFromManufacturerPdfButton" Content="Browse..." Width="80" Margin="6,0,0,0" />
                        </Grid>
                        <Button Name="SaveRequestedFromManufacturerButton" Content="Save" HorizontalAlignment="Left" />
                        <TextBlock Name="RequestedFromManufacturerStatusLabel" Margin="0,10,0,0" Foreground="#FF6B6B" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
