<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.AppSettingsView">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="App Settings" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer>
            <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="12">

                <!-- Template storage location -->
                <Border BorderBrush="#808080" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Template Storage Location:" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" FontSize="11"
                                   Text="Shared folder where all template files are saved. All users on all machines must point to the same location (e.g. a network drive)."
                                   Margin="0,0,0,8" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <TextBox Grid.Column="0" Name="StorageLocationBox" Watermark="e.g. \\server\templates or /mnt/shared/templates" />
                            <Button Grid.Column="1" Name="BrowseButton" Content="Browse..." Width="80" Margin="6,0,0,0" />
                        </Grid>
                        <Button Name="SaveButton" Content="Save" HorizontalAlignment="Left" />
                        <TextBlock Name="StatusLabel" Margin="0,10,0,0" Foreground="#800000" />
                    </StackPanel>
                </Border>

                <!-- Database location -->
                <Border BorderBrush="#808080" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Database Location:" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" FontSize="11"
                                   Text="The shared SQLite database file used by all users. If the app runs from a shared network drive, the pointer file can also be shared there so other machines pick up the path automatically."
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Active database:" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Name="CurrentDbPathLabel" TextWrapping="Wrap" Foreground="#404040"
                                   FontSize="11" Margin="0,0,0,4" />
                        <TextBlock Text="Pointer file:" FontSize="10" Margin="0,0,0,2" />
                        <TextBlock Name="PointerFilePathLabel" TextWrapping="Wrap" Foreground="#606060"
                                   FontSize="10" Margin="0,0,0,16" />

                        <TextBlock Text="Connect to existing database:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" FontSize="11"
                                   Text="Points this installation at an existing .db file without copying anything."
                                   Margin="0,0,0,6"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBox Grid.Column="0" Name="DbConnectPathBox" Watermark="Path to existing .db file" />
                            <Button Grid.Column="1" Name="DbConnectBrowseButton" Content="Browse..." Width="80" Margin="6,0,0,0" />
                        </Grid>
                        <Button Name="DbConnectButton" Content="Connect" HorizontalAlignment="Left" />

                        <Separator Margin="0,16,0,12" Background="#C0C0C0" Height="1"/>

                        <TextBlock Text="Move database to a new folder:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" FontSize="11"
                                   Text="Copies the current database to the chosen folder, then switches to that copy."
                                   Margin="0,0,0,6"/>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBox Grid.Column="0" Name="DbMoveTargetBox" Watermark="Target folder for database file" />
                            <Button Grid.Column="1" Name="DbMoveBrowseButton" Content="Browse..." Width="80" Margin="6,0,0,0" />
                        </Grid>
                        <Button Name="MoveDbButton" Content="Move Database" HorizontalAlignment="Left" />
                        <TextBlock Name="DbStatusLabel" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#800000" />
                    </StackPanel>
                </Border>

                <!-- Missing-template email alerts (Phase 24) -->
                <Border BorderBrush="#808080" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Missing-Template Email Alerts:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444444" FontSize="11"
                                   Text="If hardware items on an active job have no templates one week after job creation, an alert email is sent at startup. Leave blank to disable."
                                   Margin="0,0,0,8"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="SMTP Host:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Name="SmtpHostBox" Watermark="e.g. smtp.gmail.com" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="SMTP Port:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Name="SmtpPortBox" Watermark="587" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Username:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Name="SmtpUsernameBox" Watermark="user@example.com" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" Name="SmtpPasswordBox" PasswordChar="*" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Alert To:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" Name="AlertEmailToBox" Watermark="recipient@example.com" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Alert From:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox   Grid.Row="5" Grid.Column="1" Name="AlertEmailFromBox" Watermark="sender@example.com"/>
                        </Grid>
                        <Button Name="SaveSmtpButton" Content="Save SMTP Settings" HorizontalAlignment="Left"/>
                        <TextBlock Name="SmtpStatusLabel" Margin="0,10,0,0" Foreground="#800000"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
