<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HardwareTemplateBuilder.App.Views.DatabaseSetupDialog"
        x:CompileBindings="False"
        Title="Database Setup"
        Width="530"
        Height="360"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#2C2F38">
    <DockPanel Margin="16">

        <!-- Error banner — shown only when previously configured connection is unreachable -->
        <Border Name="ErrorPanel"
                DockPanel.Dock="Top"
                Background="#3B1219"
                BorderBrush="#FF6B6B"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10"
                IsVisible="False">
            <StackPanel>
                <TextBlock Text="Database Unreachable" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,0,0,4"/>
                <TextBlock Name="UnreachablePathLabel" TextWrapping="Wrap" Foreground="#FF6B6B"/>
            </StackPanel>
        </Border>

        <!-- Heading -->
        <TextBlock DockPanel.Dock="Top"
                   Name="HeaderLabel"
                   Text="Connect to the Shared Database"
                   FontSize="13" FontWeight="Bold"
                   Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top"
                   Text="Enter the MySQL connection string used by every workstation to reach the shared, centralized database."
                   TextWrapping="Wrap"
                   Foreground="#A7ADB8"
                   Margin="0,0,0,12"/>

        <!-- Connection string entry -->
        <Border BorderBrush="#454952" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="MySQL connection string" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Example: Server=localhost;Port=3306;Database=hardware_templates;Uid=root;Pwd=secret;"
                           TextWrapping="Wrap" Foreground="#A7ADB8" Margin="0,0,0,6"/>
                <TextBox Name="ConnectionStringBox"
                         Watermark="Server=...;Port=3306;Database=...;Uid=...;Pwd=...;"
                         AcceptsReturn="False"
                         Margin="0,0,0,8"/>
                <Button Name="ConnectButton" Content="Connect" HorizontalAlignment="Left"/>
                <TextBlock Name="ConnectStatusLabel" Foreground="#FF6B6B"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

    </DockPanel>
</Window>
