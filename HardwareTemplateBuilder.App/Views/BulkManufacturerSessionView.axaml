<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.BulkManufacturerSessionView">
    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Name="BackButton" Content="← Back to Job" Margin="0,0,8,0"/>
            <TextBlock Name="TitleLabel" DockPanel.Dock="Left"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Bottom action bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Name="AddAllButton" Content="Add All to Job →" IsEnabled="False" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Name="ItemsToFixButton" Content="Items to Fix" IsEnabled="False" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Name="StatusLabel" VerticalAlignment="Center" Foreground="#FF6B6B" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Add-manufacturer panel -->
        <Border DockPanel.Dock="Top" BorderBrush="#454952" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Add Manufacturer to Session:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox Name="MfrCombo" MinWidth="220"/>
                    <Button Name="AddMfrToSessionButton" Content="Add to Session"/>
                    <Button Name="ShowNewMfrButton" Content="+ New"/>
                </StackPanel>
                <StackPanel Name="NewMfrPanel" IsVisible="False" Orientation="Horizontal"
                            Spacing="6" Margin="0,6,0,0">
                    <TextBox Name="NewMfrBox" Watermark="New manufacturer name…" MinWidth="220"/>
                    <Button Name="SaveNewMfrButton" Content="Save"/>
                    <Button Name="CancelNewMfrButton" Content="✕"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Session list (code-generated) -->
        <ScrollViewer>
            <StackPanel Name="SessionPanel" Spacing="6"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
