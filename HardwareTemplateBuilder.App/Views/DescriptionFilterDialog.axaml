<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:views="using:HardwareTemplateBuilder.App.Views"
		x:Class="HardwareTemplateBuilder.App.Views.DescriptionFilterDialog"
		Title="Filter Descriptions"
		Width="360"
		SizeToContent="Height"
		MaxHeight="640"
		WindowStartupLocation="CenterOwner"
		CanResize="True">
	<DockPanel Margin="12">
		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
					Spacing="8" Margin="0,10,0,0">
			<Button Name="OkButton"     Content="OK" IsDefault="True"/>
			<Button Name="CancelButton" Content="Cancel" IsCancel="True"/>
		</StackPanel>

		<TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
				   Text="Choose which descriptions to include on the cover sheet for this manufacturer."/>

		<CheckBox DockPanel.Dock="Top" Name="SelectAllCheckBox" Content="Select All" Margin="0,0,0,8"/>

		<ScrollViewer MaxHeight="520">
			<ItemsControl Name="DescriptionsList">
				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="views:DescriptionFilterRow">
						<CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2,0,2"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DockPanel>
</Window>
