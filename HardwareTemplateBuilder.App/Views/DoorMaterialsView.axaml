<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.DoorMaterialsView">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Door Materials" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="Door materials are fixed: Hollow Metal and Wood. These records are seeded automatically."
                   Foreground="#404040" Margin="0,0,0,12" TextWrapping="Wrap" />
        <ListBox Name="RecordList" MaxHeight="120" />
    </DockPanel>
</UserControl>
