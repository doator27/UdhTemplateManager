<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.BackupDatabaseView">

    <StackPanel Margin="12" Spacing="12">
        <!-- Header -->
        <TextBlock Text="Database Backup"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <TextBlock Text="Create a timestamped backup copy of the database at the specified location."
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#A7ADB8"
                   Margin="0,0,0,8" />

        <!-- Current database path -->
        <Border Classes="panel"
                Margin="0,0,0,8">
            <StackPanel Spacing="4">
                <TextBlock Text="Current Database Location:"
                           FontWeight="Bold"
                           FontSize="11" />
                <TextBlock Name="DatabasePathLabel"
                           Text="Loading..."
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#A7ADB8" />
                <TextBlock Name="DatabaseSizeLabel"
                           Text=""
                           FontSize="10"
                           Foreground="#A7ADB8" />
            </StackPanel>
        </Border>

        <!-- Backup location -->
        <Border Classes="panel">
            <StackPanel Spacing="6">
                <TextBlock Text="Backup Location:"
                           FontWeight="Bold"
                           FontSize="11" />
                
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="BackupPathBox"
                             IsReadOnly="True"
                             Background="#2C2F38"
                             Padding="4"
                             FontSize="11" />
                    <Button Grid.Column="1"
                            Name="BrowseButton"
                            Content="Browse..."
                            Margin="4,0,0,0" />
                </Grid>

                <TextBlock Text="Backup files will be named: hardware_templates_backup_yyyy-MM-dd_HH-mm-ss.db"
                           FontSize="10"
                           Foreground="#A7ADB8"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Name="BackupButton"
                    Content="Create Backup"
                    FontWeight="Bold" />
            <Button Name="BackButton"
                    Content="← Back" />
        </StackPanel>

        <!-- Status message -->
        <TextBlock Name="StatusLabel"
                   Text=""
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <!-- Progress indicator (hidden by default) -->
        <Border Name="ProgressPanel"
                IsVisible="False"
                Classes="panel"
                Margin="0,8,0,0">
            <StackPanel Spacing="6">
                <TextBlock Name="ProgressLabel"
                           Text="Creating backup..."
                           FontWeight="Bold"
                           FontSize="11" />
                <ProgressBar IsIndeterminate="True"
                             Height="4" />
            </StackPanel>
        </Border>

        <!-- Recent backups list -->
        <Border Name="RecentBackupsPanel"
                Classes="panel"
                Margin="0,16,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Recent Backups:"
                           FontWeight="Bold"
                           FontSize="11" />
                
                <ListBox Name="RecentBackupsList"
                         Height="150"
                         Background="#2C2F38"
                         BorderBrush="#2C2F38"
                         BorderThickness="1" />

                <TextBlock Name="NoBackupsLabel"
                           Text="No backups found."
                           FontSize="11"
                           Foreground="#A7ADB8"
                           IsVisible="False" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="RestoreButton"
                            Content="Restore Selected Backup"
                            FontWeight="Bold"
                            Background="#5A2A2E"
                            IsEnabled="False" />
                    <Button Name="OpenBackupLocationButton"
                            Content="Open Backup Folder" />
                    <TextBlock Name="BackupLocationLabel"
                               Text=""
                               FontSize="10"
                               Foreground="#A7ADB8"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
