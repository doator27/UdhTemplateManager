<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.DashboardView">
    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock Text="Hardware Template Builder"
                       FontSize="18" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Name="WelcomeLabel"
                       FontSize="12" Foreground="#A7ADB8"
                       Margin="0,0,0,20"/>

            <!-- Primary work area -->
            <TextBlock Text="Work" FontWeight="Bold" FontSize="13" Margin="8,0,0,2"/>
            <WrapPanel Margin="0,0,0,12">
                <Button Classes="dashboard-primary" Name="BtnJobs"           Content="Jobs"/>
                <Button Classes="dashboard-primary" Name="BtnTemplateLookup" Content="Template Lookup"/>
            </WrapPanel>

            <!-- Data management -->
            <TextBlock Text="Data Management" FontWeight="Bold" FontSize="13" Margin="8,0,0,2"/>
            <WrapPanel Margin="0,0,0,12">
                <Button Classes="dashboard" Name="BtnHardwareItems"   Content="Hardware Items"/>
                <Button Classes="dashboard" Name="BtnTemplates"       Content="Templates"/>
                <Button Classes="dashboard" Name="BtnCustomers"       Content="Customers"/>
                <Button Classes="dashboard" Name="BtnManufacturers"   Content="Manufacturers"/>
                <Button Classes="dashboard" Name="BtnDescriptions"    Content="Descriptions"/>
                <Button Classes="dashboard" Name="BtnProjectManagers" Content="Project Managers"/>
                <Button Classes="dashboard" Name="BtnUserProfiles"    Content="User Profiles"/>
            </WrapPanel>

            <!-- System -->
            <TextBlock Text="System" FontWeight="Bold" FontSize="13" Margin="8,0,0,2"/>
            <WrapPanel>
                <Button Classes="dashboard" Name="BtnAppSettings"     Content="App Settings"/>
                <Button Classes="dashboard" Name="BtnRefreshTemplates" Content="Refresh Templates"/>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
