<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.DescriptionsView">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="Descriptions" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <Grid ColumnDefinitions="250,*">
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Filter:" Margin="0,0,0,2" />
                <TextBox DockPanel.Dock="Top" Name="FilterBox" Watermark="Search..." Margin="0,0,0,4" />
                <ListBox Name="RecordList" />
            </DockPanel>
            <Border Grid.Column="1" Classes="panel" BorderBrush="#808080" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="Description:" Margin="0,0,0,2" />
                    <TextBox Name="DescriptionBox" Margin="0,0,0,10" />
                    <TextBlock Text="Sort Weight (00.000.000):" Margin="0,0,0,2" />
                    <TextBox Name="WeightValueBox" Watermark="e.g. 01.002.015" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Name="SaveButton" Content="Save" Margin="0,0,8,0" />
                        <Button Name="NewButton" Content="New" Margin="0,0,8,0" />
                        <Button Name="DeleteButton" Content="Delete" />
                    </StackPanel>
                    <TextBlock Name="StatusLabel" Margin="0,10,0,0" Foreground="#800000" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
