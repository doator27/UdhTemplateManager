<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HardwareTemplateBuilder.App.Views.ItemsToFixDialog"
        Title="Items to Fix"
        Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,10,0,0">
            <Button Name="GoToButton" Content="Go to Manufacturer →" IsDefault="True"/>
            <Button Name="CloseButton" Content="Close" IsCancel="True"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="These items were skipped during the last &quot;Add All to Job&quot; run. Select one and click &quot;Go to Manufacturer&quot; to fix and re-add it."/>

        <ListBox Name="ItemsList"/>
    </DockPanel>
</Window>
