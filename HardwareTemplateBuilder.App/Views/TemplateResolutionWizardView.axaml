<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.TemplateResolutionWizardView">
    <DockPanel Margin="8">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Name="ItemHeaderLabel" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Navigation footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left"  Name="PrevButton"   Content="← Previous" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Name="FinishButton" Content="Finish"      IsVisible="False"/>
            <Button DockPanel.Dock="Right" Name="NextButton"   Content="Next →"      Margin="0,0,8,0"/>
            <TextBlock Name="WizardStatusLabel" VerticalAlignment="Center" Foreground="#FF6B6B" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Scrollable body -->
        <ScrollViewer>
            <StackPanel Spacing="8">

                <!-- Labels (read-only, set in item entry view) -->
                <Border BorderBrush="#454952" BorderThickness="1" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Labels / Line Items:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Name="LabelsDisplayPanel" Spacing="2"/>
                        <TextBlock Name="NoLabelsHint" Text="(no custom labels — will use model number)"
                                   Foreground="#454952" FontStyle="Italic" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Status panel (shown for both cases) -->
                <TextBlock Name="ItemStatusLabel" TextWrapping="Wrap" FontStyle="Italic" Foreground="#A7ADB8"/>

                <!-- Linked templates list (Case A — matched item) -->
                <Border Name="MatchedPanel" IsVisible="False"
                        BorderBrush="#454952" BorderThickness="1" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Templates already linked to this item:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ListBox Name="LinkedTemplatesList" Height="80"/>

                        <!-- Only visible when importing job-specific templates from another job -->
                        <StackPanel Name="ImportedTemplatesSection" IsVisible="False" Margin="0,10,0,0">
                            <TextBlock Text="Job-specific templates to import:" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox Name="ImportedTemplatesList" Height="80"/>
                            <Button Name="RemoveImportedTemplateButton" Content="Remove Selected"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Template add form (Case B — new item) -->
                <Border Name="NewItemPanel" IsVisible="False"
                        BorderBrush="#454952" BorderThickness="1" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Add Templates for this new item:" FontWeight="Bold" Margin="0,0,0,6"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              Margin="0,0,0,6">
                            <!-- Row 0–1: Template # (full width) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Template #:" Margin="0,0,0,2"/>
                            <TextBox   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="TplNumberBox" Margin="0,0,0,4"/>

                            <!-- Row 2: Job-specific toggle -->
                            <CheckBox  Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Name="TplJobSpecificCheck"
                                       Content="Job-specific (hidden from other jobs' template searches)"
                                       Margin="0,0,0,8"/>

                            <!-- Row 3–4: Description | Door Material -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:"   Margin="0,0,8,2"/>
                            <ComboBox  Grid.Row="4" Grid.Column="0" Name="TplDescCombo"   HorizontalAlignment="Stretch" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Door Material:" Margin="0,0,0,2"/>
                            <ComboBox  Grid.Row="4" Grid.Column="1" Name="TplMaterialCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                            <!-- Row 5–6: Num Pages | Pages To Print -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Num Pages:"     Margin="0,0,8,2"/>
                            <TextBox   Grid.Row="6" Grid.Column="0" Name="TplNumPagesBox" Text="1" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Pages To Print:" Margin="0,0,0,2"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" Name="TplPagesBox"    Watermark="e.g. 1  or  1,3-5" Margin="0,0,0,8"/>

                            <!-- Row 7–8: Pages To Rotate | Rotation Direction -->
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Pages To Rotate:" Margin="0,0,8,2"/>
                            <TextBox   Grid.Row="8" Grid.Column="0" Name="TplPagesToRotateBox" Watermark="optional, e.g. 2,4" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Rotation Direction (°):" Margin="0,0,0,2"/>
                            <TextBox   Grid.Row="8" Grid.Column="1" Name="TplRotationDirectionBox" Watermark="e.g. 90 or -90" Margin="0,0,0,8"/>

                            <!-- Row 9–10: Online Link | Local File -->
                            <TextBlock Grid.Row="9"  Grid.Column="0" Text="Online Link (optional):" Margin="0,0,8,2"/>
                            <TextBox   Grid.Row="10" Grid.Column="0" Name="TplOnlineLinkBox" Watermark="https://..." Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="9"  Grid.Column="1" Text="Local File (optional):" Margin="0,0,0,2"/>
                            <Grid      Grid.Row="10" Grid.Column="1" ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Name="TplLocalLinkBox" Watermark="Path to PDF..."/>
                                <Button  Grid.Column="1" Name="TplBrowseButton" Content="..." Width="32" Margin="4,0,0,0"/>
                            </Grid>
                        </Grid>

                        <Button Name="AddTemplateButton" Content="Add Template" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                        <TextBlock Name="AddTemplateStatusLabel" Foreground="#FF6B6B" TextWrapping="Wrap" Margin="0,0,0,6"/>

                        <TextBlock Text="Staged templates:" FontWeight="Bold" Margin="0,4,0,4"/>
                        <ListBox Name="PendingTemplatesList" Height="100"/>
                        <Button Name="RemovePendingTemplateButton" Content="Remove Selected" HorizontalAlignment="Left" Margin="0,4,0,0"/>

                        <!-- Search for an existing template by partial number -->
                        <Button Name="ToggleSearchButton" Content="Search for existing template…"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <Border Name="SearchExistingPanel" IsVisible="False"
                                BorderBrush="#454952" BorderThickness="1" Padding="8" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Search existing templates for this manufacturer:"
                                           FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="Template #:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox   Grid.Column="1" Name="SearchTplNumBox" Watermark="partial number…"/>
                                    <TextBlock Grid.Column="2" Text="Description:" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <ComboBox  Grid.Column="3" Name="SearchTplDescCombo" HorizontalAlignment="Stretch"/>
                                </Grid>
                                <ListBox Name="SearchTplResultsList" Height="100" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Name="StageSearchResultButton" Content="Stage Selected"/>
                                </StackPanel>
                                <TextBlock Name="SearchTplStatusLabel" Foreground="#FF6B6B"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
