<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.UserProfilesView">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="User Profiles" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid ColumnDefinitions="250,*">
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Filter:" Margin="0,0,0,2" />
                <TextBox DockPanel.Dock="Top" Name="FilterBox" Watermark="Search..." Margin="0,0,0,4" />
                <ListBox Name="RecordList" />
            </DockPanel>
            <Border Grid.Column="1" Classes="panel" BorderBrush="#454952" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="User Name:" Margin="0,0,0,2" />
                    <TextBox Name="UserNameBox" Margin="0,0,0,10" />
                    <TextBlock Text="Custom Job Save Location (optional):" Margin="0,0,0,2" />
                    <TextBlock Text="Leave blank to save jobs to the shared App Settings location only. Templates always use the App Settings location." Foreground="#9AA0A6" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Name="BrowseJobLocationButton" Content="Browse..." Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Name="ClearJobLocationButton" Content="Clear" Margin="8,0,0,0" />
                        <TextBox Name="CustomJobSaveLocationBox" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="SaveButton" Content="Save" Margin="0,0,8,0" />
                        <Button Name="NewButton" Content="New" Margin="0,0,8,0" />
                        <Button Name="DeleteButton" Content="Delete" />
                    </StackPanel>
                    <TextBlock Name="StatusLabel" Margin="0,10,0,0" Foreground="#FF6B6B" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
