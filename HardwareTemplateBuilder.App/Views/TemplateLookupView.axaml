<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.TemplateLookupView">
    <DockPanel Margin="8">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Individual Template Lookup" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Progress + status (docked bottom) -->
        <ProgressBar DockPanel.Dock="Bottom" Name="GenerateProgress"
                     IsIndeterminate="True" IsVisible="False"
                     Height="14" Margin="0,8,0,4"/>
        <TextBlock DockPanel.Dock="Bottom" Name="StatusLabel" Foreground="#FF6B6B" TextWrapping="Wrap"/>

        <!-- Manufacturer / Description / Model# (cascading, multi-select) + Selected Item panel -->
        <Grid ColumnDefinitions="*,*,*,220">

            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock DockPanel.Dock="Top" Text="Manufacturer" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="MfrList" SelectionMode="Multiple"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,0,4,0">
                <TextBlock DockPanel.Dock="Top" Text="Description" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="DescList" SelectionMode="Multiple"/>
            </DockPanel>

            <DockPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Model #" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="ModelList"/>
            </DockPanel>

            <!-- Selected item + action panel -->
            <Border Grid.Column="3"
                    BorderBrush="#454952" BorderThickness="1"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="Selected Item" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Name="SelectedMfrLabel"  TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedDescLabel" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedModelLabel" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedFreqLabel" Foreground="#A7ADB8" Margin="0,0,0,12"/>

                    <Button Name="GenerateButton"
                            Content="Generate PDF"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
