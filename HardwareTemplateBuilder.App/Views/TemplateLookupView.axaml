<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.TemplateLookupView">
    <DockPanel Margin="8">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Individual Template Lookup" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Search controls -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#454952" BorderThickness="1"
                Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Search Hardware Items:" FontWeight="Bold" Margin="0,0,0,4"/>
                <Grid ColumnDefinitions="*,*,*">
                    <ComboBox Grid.Column="0" Name="MfrCombo"
                              HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                    <ComboBox Grid.Column="1" Name="DescCombo"
                              HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                    <TextBox  Grid.Column="2" Name="ModelBox"
                              Watermark="Model #"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Progress + status (docked bottom) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar Name="GenerateProgress"
                         IsIndeterminate="True" IsVisible="False"
                         Height="14" Margin="0,0,0,4"/>
            <TextBlock Name="StatusLabel" Foreground="#FF6B6B" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Results list (left) + action panel (right) -->
        <Grid ColumnDefinitions="*,220">

            <!-- Results listbox -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="Matching hardware items (sorted by frequency):"
                           Margin="0,0,0,4"/>
                <ListBox Name="ResultsList"/>
            </DockPanel>

            <!-- Action panel -->
            <Border Grid.Column="1"
                    BorderBrush="#454952" BorderThickness="1"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="Selected Item" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Name="SelectedMfrLabel"  TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedDescLabel" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedModelLabel" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Name="SelectedFreqLabel" Foreground="#A7ADB8" Margin="0,0,0,12"/>

                    <Button Name="GenerateButton"
                            Content="Generate PDF"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
