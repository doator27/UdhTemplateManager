<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HardwareTemplateBuilder.App.Views.ProfilePickerDialog"
        x:CompileBindings="False"
        Title="Who are you?"
        Width="460"
        Height="480"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#2C2F38">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Select your user profile to continue."
                   FontSize="13" FontWeight="Bold"
                   Margin="0,0,0,14"/>

        <!-- Select existing profile -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#454952" BorderThickness="1"
                Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Existing Profiles:" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox Name="ProfileList" Height="110" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Name="SelectButton" Content="Select Profile" Margin="0,0,0,0"/>
                </StackPanel>
                <TextBlock Name="SelectStatus" Foreground="#FF6B6B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Create new profile -->
        <Border BorderBrush="#454952" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Or create a new profile:" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="Name:" Margin="0,0,0,2"/>
                <TextBox Name="NewNameBox" Margin="0,0,0,8"/>
                <Button Name="CreateButton" Content="Create &amp; Select"
                        HorizontalAlignment="Left"/>
                <TextBlock Name="CreateStatus" Foreground="#FF6B6B" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
