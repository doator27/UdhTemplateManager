<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HardwareTemplateBuilder.App.Views"
        x:Class="HardwareTemplateBuilder.App.Views.CatalogLookupWindow"
        Title="Look Up in Product Catalog"
        Width="1100" Height="720" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Name="HeaderText" Text="Look Up in Product Catalog" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Callout:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Name="CalloutBox" Watermark="Model number and options, e.g. 4040XP EDA RW/PA"/>
            <Button Grid.Column="2" Name="LookUpButton" Content="Look Up" Margin="6,0,0,0" IsDefault="True"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Name="LinkButton" Content="Link This Template" IsEnabled="False" IsVisible="False"/>
                <Button Name="UseButton" Content="Use This Template #" IsEnabled="False" IsVisible="False" Classes="dashboard-primary"/>
                <Button Name="CloseButton" Content="Close" IsCancel="True"/>
            </StackPanel>
            <TextBlock Name="StatusLabel" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
        </DockPanel>

        <Grid ColumnDefinitions="2*,8,3*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Text="Catalog pages (best first):" Margin="0,0,0,4"/>
                <ListBox Grid.Row="1" Name="HitsList" FontSize="12"/>
                <TextBlock Grid.Row="2" Text="Template numbers on this page:" Margin="0,8,0,4"/>
                <ListBox Grid.Row="3" Name="TemplatesList" FontSize="12" Height="80"/>
                <TextBlock Grid.Row="4" Text="On the page:" Margin="0,8,0,4"/>
                <TextBox Grid.Row="5" Name="SnippetBox" IsReadOnly="True" TextWrapping="Wrap" Height="90" FontFamily="Consolas,Menlo,monospace" FontSize="11"/>
            </Grid>
            <views:TemplatePreviewPanel Grid.Column="2" Name="PreviewPanel"/>
        </Grid>
    </DockPanel>
</Window>
