<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.JobDetailView">
    <DockPanel Margin="8">
        <!-- Top: navigation + action buttons + job title -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Name="BackButton"         Content="← Back to Jobs"  Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Left" Name="MarkCompleteButton" Content="✓ Mark Complete"  Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Left" Name="ReactivateButton"   Content="↺ Reactivate"    IsVisible="False" Margin="0,0,6,0"/>
            <TextBlock Name="JobStatusLabel" DockPanel.Dock="Left"  VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#A7ADB8" FontStyle="Italic"/>
            <TextBlock Name="JobTitleLabel" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer>
            <StackPanel>

                <!-- Job Attachments sub-panel -->
                <Border Classes="panel" BorderBrush="#454952" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Job Attachments" FontWeight="Bold" Margin="0,0,0,6"/>
                        <StackPanel Name="AttachmentsBody">
                            <ListBox Name="AttachmentList" Height="110" Margin="0,0,0,8"/>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                                <TextBlock Grid.Column="0" Text="Note (optional):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox   Grid.Column="1" Name="AttachmentNoteBox" Watermark="Describe this file…"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                                <Button Name="AddEmailButton"         Content="+ Add Email…"/>
                                <Button Name="AddPdfButton"           Content="+ Add PDF…"/>
                                <Button Name="OpenAttachmentButton"   Content="Open"/>
                                <Button Name="RemoveAttachmentButton" Content="Remove"/>
                            </StackPanel>
                            <TextBlock Name="AttachmentStatusLabel" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Linked Hardware Items sub-panel -->
                <Border Classes="panel" BorderBrush="#454952" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="Linked Hardware Items" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Name="BulkAddButton"      Content="Add Hardware"/>
                                <Button Name="ImportHardwareButton" Content="Import Hardware"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Name="LinkedHardwareBody">

                            <ListBox Name="LinkedHardwareList" Height="180" Margin="0,0,0,8"/>
                            <Button Name="RemoveHardwareButton" Content="Remove from Job" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <TextBlock Name="LinkStatusLabel" Foreground="#FF6B6B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- PDF Package Generation sub-panel -->
                <Border Classes="panel" BorderBrush="#454952" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="PDF Package Generation" FontWeight="Bold" Margin="0,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Name="GeneratePackageButton"    Content="Generate Package"    Margin="0,0,8,0"/>
                            <Button Name="OpenCurrentPackageButton" Content="Open Current Package" Margin="0,0,8,0"/>
                            <Button Name="BrowseOldVersionsButton"  Content="Browse Old Versions"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Spacing="6">
                            <ComboBox Name="ManufacturerFilterComboBox" Width="220" PlaceholderText="Select manufacturer…"/>
                            <Button Name="GenerateForManufacturerButton" Content="Generate Cover Sheet for Manufacturer"/>
                        </StackPanel>
                        <ProgressBar Name="PackageProgress"
                                     IsIndeterminate="True" IsVisible="False"
                                     Height="14" Margin="0,0,0,4"/>
                        <TextBlock Name="PackageStatusLabel" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
