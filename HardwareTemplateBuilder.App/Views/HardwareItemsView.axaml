<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.HardwareItemsView">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Hardware Items" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid ColumnDefinitions="300,*">
            <!-- Left: search and list -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Manufacturer:" Margin="0,0,0,2"/>
                <ComboBox DockPanel.Dock="Top" Name="MfrCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                
                <TextBlock DockPanel.Dock="Top" Text="Description:" Margin="0,0,0,2"/>
                <ComboBox DockPanel.Dock="Top" Name="DescCombo" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                
                <TextBlock DockPanel.Dock="Top" Text="Filter by Model:" Margin="0,0,0,2"/>
                <TextBox DockPanel.Dock="Top" Name="FilterBox" Watermark="Search model..." Margin="0,0,0,8"/>
                
                <CheckBox DockPanel.Dock="Top" Name="ShowInactiveCheck" Content="Show Inactive Items" Margin="0,0,0,8"/>
                
                <TextBlock DockPanel.Dock="Top" Text="Results:" Margin="0,0,0,2"/>
                <ListBox Name="RecordList"/>
            </DockPanel>
            <!-- Right: form -->
            <ScrollViewer Grid.Column="1">
                <Border Classes="panel" BorderBrush="#808080" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Selected Item Details:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border BorderBrush="#808080" BorderThickness="1" Padding="8" Margin="0,0,0,12" Background="#F0F0F0">
                            <StackPanel>
                                <TextBlock Name="SelectedMfrLabel" Margin="0,0,0,4"/>
                                <TextBlock Name="SelectedDescLabel" Margin="0,0,0,4"/>
                                <TextBlock Name="SelectedModelLabel" Margin="0,0,0,4"/>
                                <TextBlock Name="SelectedFreqLabel"/>
                            </StackPanel>
                        </Border>
                        
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer:" Margin="0,0,8,2"/>
                            <ComboBox Grid.Row="1" Grid.Column="0" Name="ManufacturerCombo" HorizontalAlignment="Stretch" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Description:" Margin="0,0,0,2"/>
                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Name="PickDescriptionButton" Content="Pick" Width="46" Margin="4,0,0,0"/>
                                <Border BorderBrush="#808080" BorderThickness="1" Padding="5,3">
                                    <TextBlock Name="DescriptionLabel" Text="(none)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Model Number:" Margin="0,0,8,2"/>
                            <TextBox Grid.Row="3" Grid.Column="0" Name="ModelNumberBox" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Frequency (read-only):" Margin="0,0,0,2"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Name="FrequencyBox" IsReadOnly="True" Background="#E0E0E0" Margin="0,0,0,8"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" Name="IsActiveCheck" Content="Active" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="Remarks (optional):" Margin="0,0,0,2"/>
                            <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Name="RemarksBox"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Name="SaveButton"     Content="Save"      Margin="0,0,8,0"/>
                            <Button Name="NewButton"      Content="New"       Margin="0,0,8,0"/>
                            <Button Name="DeleteButton"   Content="Delete"    Margin="0,0,8,0"/>
                            <Button Name="OpenItemButton" Content="Open Item"/>
                        </StackPanel>
                        <TextBlock Name="StatusLabel" Margin="0,8,0,0" Foreground="#800000"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
