<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.DeduplicateHardwareView">
    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Name="MainMenuButton" Content="← Main Menu" Margin="0,0,12,0"/>
            <TextBlock Text="Deduplicate" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Status bar -->
        <TextBlock DockPanel.Dock="Bottom"
                   Name="StatusLabel"
                   Foreground="#800000"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>

        <ScrollViewer>
            <StackPanel>

                <!-- ── Hardware Items section ────────────────────────────────── -->
                <Border BorderBrush="#808080" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Hardware Items" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444" FontSize="11" Margin="0,0,0,8">
                            Finds hardware items that share the same Manufacturer, Description, and Model Number.
                            Select which item to keep — all job links and template links on the discarded items
                            will be re-pointed to the kept item before deletion.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="ScanButton"     Content="Scan for Duplicate Hardware"/>
                            <Button Name="MergeAllButton" Content="Merge All"  IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Name="GroupsPanel" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── Templates section ─────────────────────────────────────── -->
                <Border BorderBrush="#808080" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Templates" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#444" FontSize="11" Margin="0,0,0,8">
                            Finds templates that share an identical Online Link or Local File path.
                            Select which template to keep — all hardware item links will be re-pointed
                            to the kept template before the duplicates are deleted.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="ScanTemplatesButton"     Content="Scan for Duplicate Templates"/>
                            <Button Name="MergeAllTemplatesButton" Content="Merge All"  IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Name="TplGroupsPanel" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
