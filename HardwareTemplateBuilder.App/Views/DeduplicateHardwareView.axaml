<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HardwareTemplateBuilder.App.Views.DeduplicateHardwareView">
    <DockPanel Margin="8">

        <!-- Top toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Deduplicate" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Status bar -->
        <TextBlock DockPanel.Dock="Bottom"
                   Name="StatusLabel"
                   Foreground="#FF6B6B"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>

        <ScrollViewer>
            <StackPanel>

                <!-- ── Templates section ─────────────────────────────────────── -->
                <Border BorderBrush="#454952" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Templates" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#A7ADB8" FontSize="11" Margin="0,0,0,8">
                            Finds templates that share an identical Online Link or Local File path.
                            Select which template to keep — all hardware item links will be re-pointed
                            to the kept template before the duplicates are deleted.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="ScanTemplatesButton"     Content="Scan for Duplicate Templates"/>
                            <Button Name="MergeAllTemplatesButton" Content="Merge All"  IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Name="TplGroupsPanel" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
